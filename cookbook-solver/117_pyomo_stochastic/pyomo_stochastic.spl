-- ============================================================
-- Recipe 117: Two-Stage Stochastic Programming (Pyomo + GLPK)
--
-- PURPOSE: Solve a two-stage stochastic LP via Pyomo's
-- Extensive Form (EF). Introduces the core SP pattern:
--
--   Stage 1 (HERE-AND-NOW): decide before uncertainty resolves
--   Stage 2 (WAIT-AND-SEE): take recourse after observing scenario
--
-- KEY STORY: A retailer must order seasonal inventory NOW, before
-- knowing demand. Demand follows three scenarios (p/n/o).
--
-- LLM baseline: "order the expected demand" → Q=190, E[cost]=$1,409.
-- Pyomo optimum: Q=200, E[cost]=$1,360 — saves $49 (VSS).
--
-- WHY Q>E[D]?
-- Shortage costs $15/unit >> holding costs $2/unit.
-- The critical ratio (shortage-order)/(shortage+holding) = 0.833
-- means order enough to cover demand in 83% of scenarios.
-- Ordering the mean (50th percentile) systematically under-stocks.
--
-- WHAT IS THE VSS?
-- Value of Stochastic Solution = EEV - RP = $1,409 - $1,360 = $49.
-- EEV: cost when you ignore uncertainty and order the mean.
-- RP: recourse problem — Pyomo's full stochastic optimum.
--
-- WHAT MAKES THIS DIFFERENT FROM S001 (PuLP)?
-- PuLP (r78): single-scenario LP — one known demand, find optimum.
-- Pyomo EF (r117): N-scenario LP — uncertainty is part of the model;
-- Stage 1 decision is common to all scenarios, Stage 2 adapts per scenario.
-- This structure is the foundation of energy dispatch, supply-chain
-- planning under demand risk, and financial portfolio rebalancing.
--
-- solver=ON  : Pyomo + GLPK solves the Extensive Form
-- solver=OFF : LLM reasons about stocking under uncertainty
--
-- Install:
--   pip install pyomo
--   conda install -c conda-forge glpk
--
-- Run:
--   spl3 run cookbook-solver/117_pyomo_stochastic/pyomo_stochastic.spl \
--       --adapter claude_cli --param use_solver=true
--
--   spl3 run cookbook-solver/117_pyomo_stochastic/pyomo_stochastic.spl \
--       --adapter ollama -m gemma3 --param use_solver=false
-- ============================================================

-- ── Prompt templates ─────────────────────────────────────────

CREATE FUNCTION reason_stochastic_prompt(problem_description TEXT)
RETURNS TEXT AS $$
You are a supply chain consultant advising a retailer on how much seasonal inventory to order.

SITUATION:
{problem_description}

Without solving a mathematical program, reason through the optimal order quantity:
1. The expected demand is 0.3×100 + 0.5×200 + 0.2×300 = 190 units. Should you order exactly 190?
2. Shortages cost $15/unit, overstock costs $2/unit. How does this asymmetry affect the decision?
3. What is the downside risk of ordering too little vs too much?
4. Give a concrete order quantity recommendation with your reasoning.

Think step by step about uncertainty, costs, and risk.
$$;

CREATE FUNCTION explain_sp_result_prompt(sp_report TEXT, problem_description TEXT)
RETURNS TEXT AS $$
You are an operations research analyst explaining two-stage stochastic programming to a business audience.

PROBLEM:
{problem_description}

SOLVER RESULT:
{sp_report}

Explain (≤200 words):
1. What does "two-stage stochastic programming" mean in plain terms for this inventory problem?
2. Why did the solver choose Q=200 rather than the expected demand of 190?
   (Hint: explain the critical ratio and asymmetric costs.)
3. What is the Value of the Stochastic Solution (VSS), and what does it tell managers?
4. Where else does this "decide now, adapt later" pattern apply?
   (e.g., energy dispatch, clinical trials, financial hedging)
$$;

WORKFLOW pyomo_stochastic
  INPUT @use_solver TEXT := "true"
  OUTPUT @report TEXT
DO
  LOGGING "[r117] pyomo_stochastic start" LEVEL INFO

  CALL get_problem_setup() INTO @problem_json;
  CALL json_get(@problem_json, "description") INTO @problem_description;
  CALL normalize_bool(@use_solver) INTO @use_solver;

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- solver=ON: Pyomo Extensive Form
      CALL solve_two_stage_sp(@problem_json) INTO @result_json;
      ASSERT sp_optimal(@result_json);
      CALL compute_ev_baseline(@problem_json) INTO @baseline_json;
      CALL format_sp_report(@result_json, @baseline_json) INTO @sp_report;
      CALL json_get(@result_json, "order_qty") INTO @q_star;
      CALL json_get(@result_json, "expected_cost") INTO @e_cost;
      LOGGING f"[r117] SP optimal: Q*={@q_star}, E[cost]=${@e_cost}" LEVEL INFO;
      GENERATE explain_sp_result_prompt(@sp_report, @problem_description) INTO @explanation;
      CALL format_report_solver_on(@sp_report, @explanation) INTO @report;

    WHEN = "false" THEN
      -- solver=OFF: LLM reasons about the stochastic decision directly
      GENERATE reason_stochastic_prompt(@problem_description) INTO @llm_strategy;
      CALL format_report_solver_off(@llm_strategy) INTO @report;
  END;

  RETURN @report WITH status = "complete", use_solver = @use_solver;

END;
