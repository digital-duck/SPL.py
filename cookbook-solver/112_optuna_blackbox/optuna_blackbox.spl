-- ============================================================
-- Recipe 112: Optuna Black-Box Strategy Optimization
--
-- PURPOSE: Optimize a business strategy with no closed-form
-- objective using Optuna TPE (Tree-structured Parzen Estimator).
-- When the objective has no gradient — only a callable function —
-- TPE efficiently explores the parameter space.
--
-- KEY STORY: SaaS marketing team tunes (price, discount, trial_days)
-- to maximize customer LTV. LLM guesses price=$50, 20% discount,
-- 14-day trial → LTV=$172. Optuna (50 trials, TPE) finds price=$43,
-- 28% discount, 7-day trial → LTV=$218 (+21%). The LTV model is
-- non-convex — gradient methods and LLM intuition both miss it.
--
-- solver=ON  : Optuna TPE 50-trial study
-- solver=OFF : LLM heuristic parameter guessing
--
-- Install: pip install optuna
--
-- Run:
--   spl3 run cookbook-solver/112_optuna_blackbox/optuna_blackbox.spl \
--       --adapter claude_cli --param use_solver=true
--
--   spl3 run cookbook-solver/112_optuna_blackbox/optuna_blackbox.spl \
--       --adapter ollama -m gemma3 --param use_solver=false
-- ============================================================

CREATE FUNCTION guess_strategy_prompt(problem_description TEXT)
RETURNS TEXT AS $$
You are a SaaS growth advisor helping a company optimize its pricing strategy.

OPTIMIZATION PROBLEM:
{problem_description}

The company's pricing strategy has three tunable parameters:
- monthly_price: the base subscription price ($30–$120/month)
- annual_discount_pct: percentage discount for annual plans (0%–40%)
- trial_days: length of free trial period (3–30 days)

The objective is to maximize customer lifetime value (LTV), which depends on:
- Conversion rate: how many trial users become paying customers
- Monthly revenue: effective revenue per customer after discount
- Churn rate: percentage of customers who cancel each month

Without running an experiment, recommend specific values for all three parameters.
Explain the reasoning behind each choice. Be specific with numbers.
$$;

CREATE FUNCTION explain_optuna_result_prompt(optuna_report TEXT, problem_description TEXT)
RETURNS TEXT AS $$
You are a growth analytics consultant. Optuna just completed a 50-trial TPE optimization.

PROBLEM:
{problem_description}

OPTUNA RESULT:
{optuna_report}

Explain (≤150 words):
1. What did Optuna find and how does it compare to the naive guess?
2. Why is price lower in the optimal solution than the naive guess? (hint: conversion)
3. Why is trial shorter in the optimal — doesn't longer trial hurt conversion?
4. What does "non-convex objective" mean here — why can't gradient descent find this?
5. In what business situations would you use Optuna vs an analytical pricing model?
$$;

WORKFLOW optuna_blackbox
  INPUT @use_solver TEXT := "true"
  OUTPUT @report TEXT
DO
  LOGGING "[r112] optuna_blackbox start" LEVEL INFO

  CALL get_default_problem() INTO @problem_json;
  CALL json_get(@problem_json, "description") INTO @problem_description;

  CALL normalize_bool(@use_solver) INTO @use_solver;

  EVALUATE @use_solver
    WHEN = "true" THEN
      CALL run_optuna_study(@problem_json) INTO @result_json;
      ASSERT optimization_improved(@result_json);
      CALL format_optuna_report(@result_json) INTO @optuna_report;
      CALL json_get(@result_json, "improvement_pct") INTO @improvement;
      CALL json_get(@result_json, "best_value") INTO @best_ltv;
      LOGGING f"[r112] best LTV=${@best_ltv} (+{@improvement}% vs naive)" LEVEL INFO;
      GENERATE explain_optuna_result_prompt(@optuna_report, @problem_description) INTO @explanation;
      CALL format_report_solver_on(@optuna_report, @explanation) INTO @report;

    WHEN = "false" THEN
      GENERATE guess_strategy_prompt(@problem_description) INTO @llm_guess;
      CALL format_report_solver_off(@llm_guess) INTO @report;
  END;

  RETURN @report WITH status = "complete", use_solver = @use_solver;

END;
