-- ============================================================
-- Recipe 103: Data Quality Validator (Great Expectations style)
--
-- PURPOSE: Validate a dataset against a declarative expectation
-- suite (GE-style). Each expectation is a named rule:
-- not_null, between, in_set, unique, regex_match, etc.
--
-- KEY STORY: A sales dataset has 12 negative amounts (billing
-- reversal bug) and 8 null customer_ids (ingestion failure).
-- LLM inspects 20 sample rows → "data looks clean."
-- Expectation engine validates all 500 rows → FAIL on 2 rules.
--
-- solver=ON  : expectation engine validates all rows in <0.1s
-- solver=OFF : LLM inspects sample rows and describes issues
--
-- Run:
--   spl3 run cookbook-solver/103_data_quality/data_quality.spl \
--       --adapter claude_cli --param use_solver=true
--
--   spl3 run cookbook-solver/103_data_quality/data_quality.spl \
--       --adapter ollama -m gemma3 --param use_solver=false
-- ============================================================


-- ── LLM prompt templates ─────────────────────────────────────

CREATE FUNCTION inspect_data_prompt(data_description TEXT)
RETURNS TEXT AS $$
You are a data quality analyst reviewing a sales transaction dataset.

DATASET DESCRIPTION:
{data_description}

The dataset has columns: transaction_id, amount, customer_id, region, date.
Expected rules:
- transaction_id: unique, not null
- amount: not null, must be > 0 and <= $10,000
- customer_id: not null
- region: one of [North, South, East, West]

Examine the description and report:
1. Which data quality rules appear to be satisfied?
2. Which rules might be violated, and why?
3. Estimate how many rows might have quality issues.
4. What action do you recommend for each issue found?

Be specific. Work from the description — do not assume the data is clean.
$$;

CREATE FUNCTION explain_failures_prompt(quality_report TEXT, data_description TEXT)
RETURNS TEXT AS $$
You are a data quality analyst. The automated expectation engine just validated a sales dataset.

DATA DESCRIPTION:
{data_description}

VALIDATION REPORT:
{quality_report}

Explain the findings in plain English (≤150 words):
1. What quality issues were found?
2. What is the likely business cause of each issue?
3. Which issue is most urgent to fix?
4. How would each issue affect downstream analysis if left uncorrected?
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW data_quality
  INPUT @data_description TEXT := "Sales transactions dataset: 500 rows, columns transaction_id, amount, customer_id, region, date. Data imported from POS systems across 4 regions over the past 6 months."
  INPUT @data_csv         TEXT := "demo"
  INPUT @use_solver       TEXT := "true"
  OUTPUT @report TEXT
DO
  LOGGING "[r103] data_quality start" LEVEL INFO

  CALL get_default_suite() INTO @suite_json;

  CALL normalize_bool(@use_solver) INTO @use_solver;

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- solver=ON: expectation engine validates all rows
      CALL run_expectations(@suite_json, @data_csv) INTO @result_json;
      CALL format_quality_report(@result_json) INTO @quality_report;
      CALL json_get(@result_json, "n_failed") INTO @n_failed;
      CALL json_get(@result_json, "n_rows") INTO @n_rows;
      LOGGING f"[r103] {@n_rows} rows, {@n_failed} expectations failed" LEVEL INFO;
      GENERATE explain_failures_prompt(@quality_report, @data_description) INTO @explanation;
      CALL format_report_solver_on(@quality_report, @explanation) INTO @report;

    WHEN = "false" THEN
      -- solver=OFF: LLM inspects description and estimates issues
      GENERATE inspect_data_prompt(@data_description) INTO @llm_analysis;
      CALL format_report_solver_off(@llm_analysis) INTO @report;
  END;

  RETURN @report WITH status = "complete", use_solver = @use_solver;

END;
