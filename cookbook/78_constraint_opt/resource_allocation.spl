-- ============================================================
-- Recipe 78d: Resource Allocation — Project Portfolio Selection (Binary ILP)
--
-- Domain: Strategic planning / IT — select which projects to fund
-- given a limited budget and headcount to maximize total value.
--
-- PuLP problem type: Binary Integer Linear Program (0-1 Knapsack variant)
--   en.wikipedia.org/wiki/Knapsack_problem
--
--   Decision variables : y[p] ∈ {0,1} — project p is selected (1) or not (0)
--   Objective          : maximize Σ value[p] · y[p]
--   Constraints        :
--     budget    — Σ cost[p]   · y[p] ≤ budget
--     headcount — Σ devmos[p] · y[p] ≤ capacity
--     y[p] ∈ {0, 1}
--
-- Default problem (6 projects, hand-verifiable):
--
--   Project | Cost ($K) | Dev-months | Value
--   --------|-----------|------------|------
--   P1      |   120     |     3      |   8
--   P2      |    80     |     2      |   5
--   P3      |   200     |     5      |  10
--   P4      |   150     |     3      |   9
--   P5      |    60     |     2      |   4
--   P6      |    90     |     2      |   6
--
--   Budget: $500K   Headcount: 10 dev-months
--
--   Known optimal: select P1+P2+P4+P6 → value = 28
--     Cost:      120+80+150+90 = $440K  ≤ $500K ✓
--     Dev-months: 3+2+3+2      = 10     ≤ 10    ✓
--     Value: 8+5+9+6 = 28
--
-- use_solver="true"  → full deterministic pipeline (PuLP + ASSERT)
-- use_solver="false" → LLM-only baseline for ablation comparison
--
-- Run:
--   spl3 run cookbook/78_constraint_opt/resource_allocation.spl --llm claude_cli
--   spl3 run cookbook/78_constraint_opt/resource_allocation.spl --llm claude_cli \
--       --param use_solver=false
-- ============================================================

-- ── Deterministic regime: PuLP ILP solver ────────────────────

CREATE TOOL_API run_pulp(code TEXT)
RETURNS TEXT AS PYTHON $$
def run_pulp(code: str) -> str:
    import json, re, pulp
    code = re.sub(r'^```(?:python)?\s*\n?', '', code.strip(), flags=re.IGNORECASE)
    code = re.sub(r'\n?```\s*$', '', code)
    code = re.sub(r'(?m)^\s*import\s+pulp\s*(?:#.*)?$', '', code)
    code = re.sub(r'(?m)^\s*from\s+pulp\s+import\s+.*$', '', code)
    code = code.replace('pulp.pulp.LpStatus', 'pulp.LpStatus')
    namespace = {"pulp": pulp}
    namespace.update({k: getattr(pulp, k) for k in dir(pulp) if not k.startswith('_') and k != 'pulp'})
    try:
        exec(code, namespace)
        result = namespace.get("_result")
        if result is None:
            return json.dumps({"status": "Error",
                               "error": "code did not set _result"})
        return json.dumps(result, default=str)
    except Exception as e:
        err = str(e)
        hints = []
        if "pulp.pulp" in err and "LpStatus" in err:
            hints.append("use pulp.LpStatus[prob.status], never pulp.pulp.LpStatus")
        if "Error while executing" in err and "cbc" in err.lower():
            hints.append(
                "CBC rejected the LP — likely cause: coefficient is a string not a number, "
                "or variable not declared before use. Check all dict values are int/float."
            )
        suffix = (" — HINTS: " + "; ".join(hints)) if hints else ""
        return json.dumps({"status": "Error", "error": err + suffix})
$$;

CREATE TOOL_API is_optimal(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def is_optimal(result_json: str) -> bool:
    import json
    try:
        return json.loads(result_json).get("status") == "Optimal"
    except Exception:
        return False
$$;

CREATE TOOL_API json_get_objective(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_objective(result_json: str) -> str:
    import json
    try:
        v = json.loads(result_json).get("objective")
        return str(v) if v is not None else ""
    except Exception:
        return ""
$$;

CREATE TOOL_API json_get_field(result_json TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_field(result_json: str, field: str) -> str:
    import json
    try:
        v = json.loads(result_json).get(field)
        return str(v) if v is not None else ""
    except Exception:
        return ""
$$;

CREATE TOOL_API verify_off_bilp(problem TEXT, claimed_json TEXT)
RETURNS TEXT AS PYTHON $$
def verify_off_bilp(problem: str, claimed_json: str) -> str:
    import json, re
    # Strip markdown fences gemma3 emits despite "no fences" instruction
    raw = claimed_json.strip()
    raw = re.sub(r'^```(?:json)?\s*\n?', '', raw, flags=re.IGNORECASE)
    raw = re.sub(r'\n?```\s*$', '', raw)
    try:
        claimed = json.loads(raw)
    except Exception as e:
        return json.dumps({"verdict": "UNPARSEABLE", "notes": f"JSON error: {e}",
                           "raw_prefix": claimed_json[:120]})

    obj_claimed  = claimed.get("objective")
    selected     = claimed.get("selected_projects", [])
    project_data = claimed.get("project_data", [])

    projects = {p["id"]: p for p in project_data if "id" in p}

    violations = []
    total_cost = total_dev = total_val = 0.0

    for pid in selected:
        p = projects.get(pid, {})
        total_cost += float(p.get("cost_K", 0))
        total_dev  += float(p.get("dev_months", 0))
        total_val  += float(p.get("value", 0))

    budget_m = re.search(
        r'(?:total )?budget (?:is )?\$(\d+(?:\.\d+)?)K', problem, re.IGNORECASE)
    dev_m = re.search(
        r'(\d+(?:\.\d+)?) developer-months available', problem, re.IGNORECASE)

    if budget_m:
        budget = float(budget_m.group(1))
        if total_cost > budget + 0.001:
            violations.append(f"budget violated: ${total_cost:.0f}K > ${budget:.0f}K")

    if dev_m:
        headcount = float(dev_m.group(1))
        if total_dev > headcount + 0.001:
            violations.append(f"headcount violated: {total_dev:.0f}mo > {headcount:.0f}mo")

    if obj_claimed is not None and project_data:
        if abs(total_val - float(obj_claimed)) > 0.5:
            violations.append(
                f"value mismatch: claimed {obj_claimed} vs computed {total_val:.0f}")

    if violations:
        return json.dumps({"verdict": "FAIL", "claimed_obj": obj_claimed,
                           "verified_obj": total_val, "notes": "; ".join(violations)})
    if not selected:
        return json.dumps({"verdict": "UNPARSEABLE", "claimed_obj": obj_claimed,
                           "notes": "no selected_projects in JSON"})
    return json.dumps({
        "verdict": "PASS", "claimed_obj": obj_claimed, "verified_obj": total_val,
        "notes": (f"{len(selected)} projects: cost=${total_cost:.0f}K, "
                  f"dev={total_dev:.0f}mo, value={total_val:.0f}")
    })
$$;

CREATE TOOL_API make_metrics(use_solver TEXT, llm_calls TEXT,
                             stage1_s TEXT, stage2_s TEXT, total_s TEXT,
                             input_tokens TEXT, output_tokens TEXT)
RETURNS TEXT AS PYTHON $$
def make_metrics(use_solver: str, llm_calls: str,
                 stage1_s: str, stage2_s: str, total_s: str,
                 input_tokens: str, output_tokens: str) -> str:
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    mode      = "solver=ON  (PuLP/CBC + ASSERT gate)" if solver_on else "solver=OFF (LLM reasoning only)"
    s1_label  = "Stage 1 — formulation + solve (s)" if solver_on else "Stage 1 — direct LLM solve (s)"

    def fmt_f(v):
        try:
            return f"{float(v):.2f}"
        except Exception:
            return v or "—"

    def fmt_i(v):
        try:
            return f"{int(v):,}"
        except Exception:
            return v or "—"

    total_tok = "—"
    try:
        total_tok = f"{int(input_tokens) + int(output_tokens):,}"
    except Exception:
        pass

    rows = [
        ("Mode",                         mode),
        ("LLM calls",                    llm_calls),
        (s1_label,                       fmt_f(stage1_s)),
        ("Stage 2 — interpretation (s)", fmt_f(stage2_s) if solver_on else "—"),
        ("Total latency (s)",            fmt_f(total_s)),
        ("Input tokens",                 fmt_i(input_tokens)),
        ("Output tokens",                fmt_i(output_tokens)),
        ("Total tokens",                 total_tok),
    ]
    header = "| Metric | Value |"
    sep    = "|---|---|"
    lines  = [header, sep] + [f"| {k} | {v} |" for k, v in rows]
    return "\n".join(lines)
$$;

CREATE TOOL_API format_portfolio(problem TEXT, use_solver TEXT, lp_code TEXT,
                                 solution_json TEXT, narrative TEXT, metrics TEXT)
RETURNS TEXT AS PYTHON $$
def format_portfolio(problem: str, use_solver: str, lp_code: str,
                     solution_json: str, narrative: str, metrics: str) -> str:
    import json
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    try:
        sol = json.loads(solution_json)
    except Exception:
        sol = {}
    status    = sol.get("status")
    objective = sol.get("objective")
    variables = sol.get("variables", {})

    lines = [
        "# Resource Allocation Report",
        "",
        f"**Problem:** {problem.strip()}",
    ]
    if solver_on and status:
        lines += ["", f"**Solver status:** `{status}`"]
    if solver_on and objective is not None:
        lines.append(f"**Maximum portfolio value:** {objective:.4g}")
    if solver_on and variables:
        try:
            selected = [k for k, v in variables.items() if float(v) > 0.5]
            rejected = [k for k, v in variables.items() if float(v) <= 0.5]
        except Exception:
            selected, rejected = [], []
        lines += ["", "**Selected projects:**"]
        for p in selected:
            lines.append(f"  ✓ {p}")
        lines += ["", "**Rejected projects:**"]
        for p in rejected:
            lines.append(f"  ✗ {p}")

    lines += ["", narrative.strip()]

    if solver_on and lp_code.strip():
        lines += ["", "## Solver Code (LLM-generated, PuLP)", "", "```python", lp_code.strip(), "```"]

    lines += ["", "## Run Metrics", "", metrics]
    return "\n".join(lines)
$$;

-- ── Probabilistic regime: LLM prompt templates ───────────────

CREATE FUNCTION formulate_portfolio_ilp(problem TEXT)
RETURNS TEXT AS $$
You are an operations research expert. Convert this project selection problem to
runnable PuLP Binary ILP code. Follow the template below EXACTLY — replace the
placeholder data with the actual numbers from the problem.

The `pulp` module is already in scope. Do NOT import anything.
Output ONLY raw Python code — no markdown fences, no comments.

TEMPLATE (copy this structure, fill in the actual project IDs, costs, dev-months, values, budget, capacity):

projects = ["P1", "P2", "P3"]          # list every project ID
cost     = {"P1": 120, "P2": 80, "P3": 200}   # cost in $K per project
devmos   = {"P1": 3,   "P2": 2,  "P3": 5}     # developer-months per project
value    = {"P1": 8,   "P2": 5,  "P3": 10}    # strategic value per project
budget   = 500    # total budget in $K
capacity = 10     # total developer-months available

prob = pulp.LpProblem("portfolio", pulp.LpMaximize)
y = {{p: pulp.LpVariable(f"y_{{p}}", cat="Binary") for p in projects}}
prob += pulp.lpSum(value[p] * y[p] for p in projects)
prob += (pulp.lpSum(cost[p] * y[p] for p in projects) <= budget)
prob += (pulp.lpSum(devmos[p] * y[p] for p in projects) <= capacity)
prob.solve(pulp.PULP_CBC_CMD(msg=0))
_result = {{
    "status": pulp.LpStatus[prob.status],
    "objective": pulp.value(prob.objective),
    "variables": {{v.name: pulp.value(v) for v in prob.variables()}}
}}

Now write the code for this problem (use the SAME structure — dicts keyed by project ID):

Problem:
{problem}
$$;

CREATE FUNCTION repair_portfolio_ilp(problem TEXT, lp_code TEXT, error_info TEXT)
RETURNS TEXT AS $$
This PuLP project portfolio ILP produced an error. Fix it.

Problem:
{problem}

Previous (broken) code:
{lp_code}

Error:
{error_info}

REQUIRED fix — rewrite using this exact structure (dicts keyed by project ID, never lists):

projects = ["P1", "P2", ...]          # all project IDs as strings
cost     = {{"P1": 120, "P2": 80, ...}}   # cost in $K
devmos   = {{"P1": 3,   "P2": 2,  ...}}   # developer-months
value    = {{"P1": 8,   "P2": 5,  ...}}   # strategic value
budget   = ...    # from problem
capacity = ...    # from problem

prob = pulp.LpProblem("portfolio", pulp.LpMaximize)
y = {{p: pulp.LpVariable(f"y_{{p}}", cat="Binary") for p in projects}}
prob += pulp.lpSum(value[p] * y[p] for p in projects)
prob += (pulp.lpSum(cost[p] * y[p] for p in projects) <= budget)
prob += (pulp.lpSum(devmos[p] * y[p] for p in projects) <= capacity)
prob.solve(pulp.PULP_CBC_CMD(msg=0))
_result = {{
    "status": pulp.LpStatus[prob.status],
    "objective": pulp.value(prob.objective),
    "variables": {{v.name: pulp.value(v) for v in prob.variables()}}
}}

Rules:
- Use DICTS (cost["P1"], not cost[0]) — list indexing by string causes TypeError
- Use y[p] everywhere — no bare variable named p
- cat="Binary" is required — never LpContinuous
- Objective must be LpMaximize (maximise value)
- Output ONLY raw Python code — no markdown fences, no commentary
$$;

CREATE FUNCTION solve_directly_portfolio(problem TEXT, lang TEXT)
RETURNS TEXT AS $$
You are a strategic planning analyst. Solve this project portfolio selection problem
using mathematical reasoning only — no solver software.

Problem: {problem}

Your response must have two sections:

## Solution
Work through the binary selection problem step by step:
1. List all projects with their cost, dev-months, and value.
2. Note the total search space (2^n subsets for n projects) and use structured
   enumeration: start with high value-to-cost ratio projects, then check
   feasibility and try swaps to improve total value.
3. Enumerate the top candidate subsets explicitly, checking budget and headcount
   constraints for each.
4. State the optimal selection and its total value.

## Verification
Confirm the selected portfolio is feasible and optimal:
- Sum the costs and confirm total ≤ budget (show arithmetic).
- Sum the dev-months and confirm total ≤ headcount limit (show arithmetic).
- Compute total value (show arithmetic).
- Show at least one alternative subset that was considered and explain why it
  scores lower or is infeasible.

Write in {lang}. Show all arithmetic explicitly.
$$;

CREATE FUNCTION extract_solution_json_bilp(problem TEXT, narrative TEXT)
RETURNS TEXT AS $$
Extract the project portfolio selection from the narrative as JSON.

IMPORTANT: Your entire response must be ONLY the JSON object below.
Do NOT write any text before or after. Do NOT use markdown code fences (no backticks).
Start your response with {{ and end with }}.

Problem:
{problem}

Solution narrative:
{narrative}

Required JSON format (fill in the actual values):
{{
  "objective": <total portfolio value as a number>,
  "selected_projects": ["P1", "P4", ...],
  "project_data": [
    {{"id": "P1", "cost_K": 120, "dev_months": 3, "value": 8}},
    {{"id": "P2", "cost_K": 80,  "dev_months": 2, "value": 5}},
    ...
  ]
}}

Instructions:
- selected_projects: only the project IDs the narrative chooses
- project_data: ALL projects from the problem statement (not just selected ones)
- objective: the total strategic value the narrative claims for the selected portfolio
$$;

CREATE FUNCTION interpret_portfolio(problem TEXT, solution_json TEXT, lang TEXT)
RETURNS TEXT AS $$
You are a strategic planning analyst. Interpret this project portfolio optimization
result for a leadership team making investment decisions.

Problem:
{problem}

Optimal portfolio (JSON — variables with value 1.0 are selected):
{solution_json}

Your response must have two sections:

## Interpretation
Concise briefing (under 200 words):
1. Which projects are selected and what is the total portfolio value?
2. What is the total cost and headcount utilized vs. available?
3. Which high-value projects were left out and why (budget, headcount, or both)?
4. One strategic observation — e.g., is there a project combination the team might
   revisit if additional budget or headcount became available?

## Solution Verification
Walk through the math to confirm correctness:
- Sum the costs of selected projects and confirm total ≤ budget (show arithmetic).
- Sum the dev-months of selected projects and confirm total ≤ headcount (show arithmetic).
- Sum the values of selected projects (show arithmetic).
- Show one rejected alternative (e.g., swapping one project) and confirm it scores
  lower or violates a constraint.
- Confirm computed value matches the solver's reported value.

Write in {lang}. No JSON, no code. Address to decision-makers, not engineers.
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW resource_allocation
  INPUT @problem TEXT := "An IT department must select a portfolio of projects for next quarter. Six candidate projects are available. Project P1 costs $120K and requires 3 developer-months, delivering strategic value 8. Project P2 costs $80K and requires 2 developer-months, delivering value 5. Project P3 costs $200K and requires 5 developer-months, delivering value 10. Project P4 costs $150K and requires 3 developer-months, delivering value 9. Project P5 costs $60K and requires 2 developer-months, delivering value 4. Project P6 costs $90K and requires 2 developer-months, delivering value 6. The total budget is $500K and the team has 10 developer-months available. Each project is either fully funded or not funded — no partial investment. Select which projects to fund to maximize total strategic value."
  INPUT @use_solver TEXT := "true"
  INPUT @max_tries INTEGER := 3
  INPUT @lang TEXT := "English"
  INPUT @out_dir TEXT := "./cookbook/78_constraint_opt/output"
  OUTPUT @report TEXT
DO
  CALL time_monotonic() INTO @t_start;
  CALL time_now() INTO @ts_safe;
  LOGGING f"[resource_allocation] start  ts={@ts_safe}  use_solver={@use_solver}" LEVEL INFO

  @llm_calls := 0;
  @tries     := 0;
  @status    := "";
  @lp_code   := "";
  @solution  := "{}";
  @stage1_s  := "0";
  @stage2_s      := "0";
  @obj_str       := "";
  @verify_status := "N/A";
  @verify_result := "{}";

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- ── Stage 1: LLM formulates Binary ILP; PuLP solves; repair loop ──
      LOGGING "[resource_allocation] Stage 1 — LLM formulation + solver" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      @status := "init";

      WHILE @tries < @max_tries DO
        EVALUATE @status
          WHEN = "Optimal" THEN
            @tries := @max_tries;

          WHEN = "init" THEN
            LOGGING "[resource_allocation] attempt 1 — LLM formulating portfolio ILP" LEVEL INFO
            GENERATE formulate_portfolio_ilp(@problem) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[resource_allocation] attempt {@tries}: status={@status}" LEVEL INFO

          ELSE
            CALL result_error(@solution) INTO @error_info;
            LOGGING f"[resource_allocation] repair {@tries} — error: {@error_info}" LEVEL INFO
            GENERATE repair_portfolio_ilp(@problem, @lp_code, @error_info) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[resource_allocation] repair {@tries}: status={@status}" LEVEL INFO
        END;
      END;

      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[resource_allocation] Stage 1 done — latency={@stage1_s}s  llm_calls={@llm_calls}" LEVEL INFO

      -- ── Stage 2: deterministic gate ───────────────────────────
      LOGGING f"[resource_allocation] ASSERT gate (status={@status})" LEVEL INFO
      ASSERT is_optimal(@solution);
      LOGGING "[resource_allocation] ASSERT passed — portfolio is provably optimal" LEVEL INFO
      LOGGING f"[resource_allocation] solver_input (lp_code):\n{@lp_code}" LEVEL DEBUG
      CALL json_get_objective(@solution) INTO @obj_str;
      LOGGING f"[resource_allocation] objective_claimed={@obj_str}  tokens_in={@_total_input_tokens}  tokens_out={@_total_output_tokens}" LEVEL INFO

      -- ── Stage 3: LLM frames portfolio decision for leadership ──
      LOGGING "[resource_allocation] Stage 3 — LLM interpreting verified portfolio" LEVEL INFO
      CALL time_monotonic() INTO @t_s3;
      GENERATE interpret_portfolio(@problem, @solution, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s3) INTO @stage2_s;
      LOGGING f"[resource_allocation] Stage 3 done — latency={@stage2_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

    ELSE
      -- ── solver=OFF: LLM solves directly (ablation baseline) ───
      LOGGING "[resource_allocation] Stage 1 — LLM solving directly (no solver)" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      GENERATE solve_directly_portfolio(@problem, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[resource_allocation] Stage 1 done — latency={@stage1_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

      -- ── Verification: back-substitute LLM solution ───────────
      LOGGING "[resource_allocation] verify_off — extracting solution JSON from narrative" LEVEL INFO
      GENERATE extract_solution_json_bilp(@problem, @narrative) INTO @claimed_json;
      @llm_calls := @llm_calls + 1;
      CALL verify_off_bilp(@problem, @claimed_json) INTO @verify_result;
      CALL json_get_field(@verify_result, "verdict") INTO @verify_status;
      CALL json_get_field(@verify_result, "claimed_obj") INTO @obj_str;
      LOGGING f"[resource_allocation] verify_off: verdict={@verify_status}  result={@verify_result}" LEVEL INFO
      LOGGING f"[resource_allocation] objective_claimed={@obj_str}  tokens_in={@_total_input_tokens}  tokens_out={@_total_output_tokens}" LEVEL INFO
  END;

  CALL time_elapsed(@t_start) INTO @total_s;
  CALL make_metrics(@use_solver, @llm_calls, @stage1_s, @stage2_s, @total_s,
                    @_total_input_tokens, @_total_output_tokens) INTO @metrics;
  CALL format_portfolio(@problem, @use_solver, @lp_code, @solution, @narrative, @metrics) INTO @report;

  CALL write_file(f"{@out_dir}/resource_allocation_{@ts_safe}.md", @report) INTO @out_path;
  LOGGING f"[resource_allocation] done — report → {@out_path}  ({@total_s}s, llm_calls={@llm_calls})" LEVEL INFO

  RETURN @report WITH status = "complete", objective = @obj_str, verify = @verify_status;

EXCEPTION
  WHEN ToolFailed THEN
    @report := "Portfolio solver did not reach Optimal after " + @tries + " attempts. Last status: " + @status;
    CALL write_file(f"{@out_dir}/resource_allocation_{@ts_safe}.md", @report) INTO @out_path;
    CALL time_elapsed(@t_start) INTO @total_s;
    LOGGING f"[resource_allocation] infeasible — {@out_path}  ({@total_s}s)" LEVEL INFO
    RETURN @report WITH status = "infeasible", objective = "", verify = "N/A";
END;
