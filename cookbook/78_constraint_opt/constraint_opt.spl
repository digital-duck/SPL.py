-- ============================================================
-- Recipe 78: Constraint Optimization — LLM formulates, solver proves
--
-- Demonstrates SPL's unique deterministic-probabilistic boundary:
--
--   Probabilistic (LLM)  — read a natural-language problem and write
--                          runnable PuLP constraint code
--   Deterministic (PuLP) — CBC solver finds the OPTIMAL solution and
--                          produces a proof of optimality; no LLM
--                          arithmetic, no hallucinated values
--   Deterministic (ASSERT) — formal gate: execution only continues
--                          when the solver confirms Optimal status
--   Probabilistic (LLM)  — interpret the solution for the user
--
-- use_solver="true"  → full deterministic pipeline (PuLP + ASSERT)
-- use_solver="false" → LLM-only baseline for ablation comparison
--
-- Requires: pip install pulp
-- Run:
--   spl3 run cookbook/78_constraint_opt/constraint_opt.spl \
--       --llm claude_cli --param use_solver=true
--   spl3 run cookbook/78_constraint_opt/constraint_opt.spl \
--       --llm claude_cli --param use_solver=false
-- ============================================================

-- ── Deterministic regime: PuLP solver tools ──────────────────

CREATE TOOL_API run_pulp(code TEXT)
RETURNS TEXT AS PYTHON $$
def run_pulp(code: str) -> str:
    """Execute LLM-generated PuLP code and return a JSON result dict.

    The LLM writes the code; this function is the deterministic oracle.
    Returns {"status": ..., "objective": ..., "variables": {...}}
    On any error returns {"status": "Error", "error": "<msg>"}.
    """
    import json
    import re
    import pulp
    # Strip markdown fences the LLM occasionally emits despite instructions
    code = re.sub(r'^```(?:python)?\s*\n?', '', code.strip(), flags=re.IGNORECASE)
    code = re.sub(r'\n?```\s*$', '', code)
    # Strip import lines that shadow the pre-injected pulp namespace.
    # 'import pulp' is harmless but redundant.
    # 'from pulp import *' is dangerous: it rebinds the name 'pulp' in the exec
    # namespace to pulp.pulp (the submodule), which lacks LpStatus.
    code = re.sub(r'(?m)^\s*import\s+pulp\s*(?:#.*)?$', '', code)
    code = re.sub(r'(?m)^\s*from\s+pulp\s+import\s+.*$', '', code)
    # Patch residual pulp.pulp.LpStatus references (gemma3 hallucination)
    code = code.replace('pulp.pulp.LpStatus', 'pulp.LpStatus')
    # Pre-inject all pulp exports so unqualified names (LpProblem, LpVariable, etc.)
    # still work after stripping 'from pulp import *'
    namespace = {"pulp": pulp}
    namespace.update({k: getattr(pulp, k) for k in dir(pulp) if not k.startswith('_') and k != 'pulp'})
    try:
        exec(code, namespace)
        result = namespace.get("_result")
        if result is None:
            return json.dumps({"status": "Error",
                               "error": "code did not set _result"})
        return json.dumps(result, default=str)
    except Exception as e:
        err = str(e)
        hint = ""
        if "pulp.pulp" in err and "LpStatus" in err:
            hint = " — use pulp.LpStatus[prob.status], never pulp.pulp.LpStatus"
        return json.dumps({"status": "Error", "error": err + hint})
$$;

CREATE TOOL_API is_optimal(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def is_optimal(result_json: str) -> bool:
    """ASSERT gate: True only when PuLP reports Optimal status."""
    import json
    try:
        return json.loads(result_json).get("status") == "Optimal"
    except Exception:
        return False
$$;

CREATE TOOL_API json_get_objective(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_objective(result_json: str) -> str:
    import json
    try:
        v = json.loads(result_json).get("objective")
        return str(v) if v is not None else ""
    except Exception:
        return ""
$$;

CREATE TOOL_API json_get_field(result_json TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_field(result_json: str, field: str) -> str:
    import json
    try:
        v = json.loads(result_json).get(field)
        return str(v) if v is not None else ""
    except Exception:
        return ""
$$;

CREATE TOOL_API verify_off_lp(problem TEXT, claimed_json TEXT)
RETURNS TEXT AS PYTHON $$
def verify_off_lp(problem: str, claimed_json: str) -> str:
    import json, re
    raw = claimed_json.strip()
    raw = re.sub(r'^```(?:json)?\s*\n?', '', raw, flags=re.IGNORECASE)
    raw = re.sub(r'\n?```\s*$', '', raw)
    try:
        claimed = json.loads(raw)
    except Exception as e:
        return json.dumps({"verdict": "UNPARSEABLE", "notes": f"JSON error: {e}",
                           "raw_prefix": claimed_json[:120]})

    obj_claimed = claimed.get("objective")
    variables   = claimed.get("variables", {})
    obj_coeffs  = claimed.get("obj_coefficients", {})
    constraints = claimed.get("constraints", [])

    violations = []

    if obj_coeffs and variables:
        try:
            recomputed = sum(float(obj_coeffs.get(k, 0)) * float(v)
                            for k, v in variables.items())
            if obj_claimed is not None and abs(recomputed - float(obj_claimed)) > 0.5:
                violations.append(
                    f"objective mismatch: claimed {obj_claimed} vs recomputed {recomputed:.4g}")
        except Exception as e:
            violations.append(f"objective recompute error: {e}")

    for c in constraints:
        name   = c.get("name", "?")
        coeffs = c.get("coefficients", {})
        limit  = c.get("limit")
        op     = c.get("op", "<=")
        try:
            lhs = sum(float(coeffs.get(k, 0)) * float(variables.get(k, 0)) for k in coeffs)
            if op == "<=" and limit is not None and lhs > float(limit) + 1e-6:
                violations.append(f"{name}: {lhs:.4g} > {limit}")
            elif op == ">=" and limit is not None and lhs < float(limit) - 1e-6:
                violations.append(f"{name}: {lhs:.4g} < {limit}")
        except Exception as e:
            violations.append(f"{name}: compute error {e}")

    if violations:
        return json.dumps({"verdict": "FAIL", "claimed_obj": obj_claimed,
                           "notes": "; ".join(violations)})
    if not constraints:
        return json.dumps({"verdict": "UNPARSEABLE", "claimed_obj": obj_claimed,
                           "notes": "no constraints in JSON"})
    return json.dumps({"verdict": "PASS", "claimed_obj": obj_claimed,
                       "notes": f"{len(constraints)} constraints verified"})
$$;

CREATE TOOL_API make_metrics(use_solver TEXT, llm_calls TEXT,
                             stage1_s TEXT, stage2_s TEXT, total_s TEXT,
                             input_tokens TEXT, output_tokens TEXT)
RETURNS TEXT AS PYTHON $$
def make_metrics(use_solver: str, llm_calls: str,
                 stage1_s: str, stage2_s: str, total_s: str,
                 input_tokens: str, output_tokens: str) -> str:
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    mode      = "solver=ON  (PuLP/CBC + ASSERT gate)" if solver_on else "solver=OFF (LLM reasoning only)"
    s1_label  = "Stage 1 — formulation + solve (s)" if solver_on else "Stage 1 — direct LLM solve (s)"

    def fmt_f(v):
        try:
            return f"{float(v):.2f}"
        except Exception:
            return v or "—"

    def fmt_i(v):
        try:
            return f"{int(v):,}"
        except Exception:
            return v or "—"

    total_tok = "—"
    try:
        total_tok = f"{int(input_tokens) + int(output_tokens):,}"
    except Exception:
        pass

    rows = [
        ("Mode",                        mode),
        ("LLM calls",                   llm_calls),
        (s1_label,                      fmt_f(stage1_s)),
        ("Stage 2 — interpretation (s)", fmt_f(stage2_s) if solver_on else "—"),
        ("Total latency (s)",            fmt_f(total_s)),
        ("Input tokens",                fmt_i(input_tokens)),
        ("Output tokens",               fmt_i(output_tokens)),
        ("Total tokens",                total_tok),
    ]
    header = "| Metric | Value |"
    sep    = "|---|---|"
    lines  = [header, sep] + [f"| {k} | {v} |" for k, v in rows]
    return "\n".join(lines)
$$;

CREATE TOOL_API format_report(problem TEXT, use_solver TEXT, lp_code TEXT,
                              solution_json TEXT, narrative TEXT, metrics TEXT)
RETURNS TEXT AS PYTHON $$
def format_report(problem: str, use_solver: str, lp_code: str,
                  solution_json: str, narrative: str, metrics: str) -> str:
    import json
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    try:
        sol = json.loads(solution_json)
    except Exception:
        sol = {}
    status    = sol.get("status")
    objective = sol.get("objective")
    variables = sol.get("variables", {})

    lines = [
        "# Constraint Optimization Report",
        "",
        f"**Problem:** {problem.strip()}",
    ]
    if solver_on and status:
        lines += ["", f"**Solver status:** `{status}`"]
    if solver_on and objective is not None:
        lines.append(f"**Optimal objective value:** {objective:.4g}")
    if solver_on and variables:
        lines += ["", "**Decision variables:**"]
        for name, val in variables.items():
            lines.append(f"  - {name} = {val:.4g}" if isinstance(val, float) else f"  - {name} = {val}")

    lines += ["", narrative.strip()]

    if solver_on and lp_code.strip():
        lines += ["", "## Solver Code (LLM-generated, PuLP)", "", "```python", lp_code.strip(), "```"]

    lines += ["", "## Run Metrics", "", metrics]
    return "\n".join(lines)
$$;

-- ── Probabilistic regime: LLM prompt templates ───────────────

CREATE FUNCTION formulate_lp(problem TEXT)
RETURNS TEXT AS $$
You are an operations research expert. Convert this optimization problem
to runnable PuLP Python code.

Rules:
- The `pulp` module is already in scope — do NOT add import statements
- Create a pulp.LpProblem, define decision variables, set the objective,
  add all constraints, then call: prob.solve(pulp.PULP_CBC_CMD(msg=0))
- After solving, store the result EXACTLY as:
    _result = {
        "status": pulp.LpStatus[prob.status],
        "objective": pulp.value(prob.objective),
        "variables": {v.name: pulp.value(v) for v in prob.variables()}
    }
- CRITICAL: use `pulp.LpStatus[prob.status]` — NEVER `pulp.pulp.LpStatus` (that submodule
  path does not exist and will raise AttributeError)
- All quantity variables must have lowBound=0 (non-negative); PuLP uses lowBound, not lb
- Output ONLY raw Python code — no markdown fences, no commentary

Problem: {problem}
$$;

CREATE FUNCTION repair_lp(problem TEXT, lp_code TEXT, error_info TEXT)
RETURNS TEXT AS $$
This PuLP optimization code produced an error or infeasible result.

Problem: {problem}

Previous code:
{lp_code}

Error / solver status:
{error_info}

Fix the code. Common causes:
- Missing lowBound=0 for non-negative variables (PuLP uses lowBound, not lb)
- Wrong constraint direction (>= vs <=)
- Typo in variable names used in constraints
- Missing or duplicate _result assignment
- Incorrect sense for LpProblem (LpMaximize vs LpMinimize)
- Using `pulp.pulp.LpStatus` — ALWAYS use `pulp.LpStatus[prob.status]` instead
- Adding `import pulp` at top — the module is already injected, do not import it

Output ONLY the corrected Python code — no markdown fences, no commentary.
$$;

CREATE FUNCTION solve_directly(problem TEXT, lang TEXT)
RETURNS TEXT AS $$
You are an operations research expert. Solve this optimization problem
using mathematical reasoning only — no solver software.

Problem: {problem}

Your response must have two sections:

## Solution
Work through the LP graphically / algebraically:
1. Define decision variables and state the objective and constraints.
2. Find the feasible region corners: for each pair of binding constraints
   solve the 2×2 system, then check feasibility of the intersection point.
3. Evaluate the objective at every corner vertex.
4. State the optimal solution (variable values and objective value).
   Note any integrality considerations if the problem implies integer quantities.

## Verification
Plug the optimal values back in and confirm:
- Each constraint is satisfied — show the arithmetic and label it binding or slack.
- Compute the objective value step by step (e.g. "3.6 × $20 + 3.2 × $30 = $72 + $96 = $168").

Write in {lang}. Show all arithmetic explicitly.
$$;

CREATE FUNCTION extract_solution_json(problem TEXT, narrative TEXT)
RETURNS TEXT AS $$
Extract the optimization solution from the narrative as structured JSON.

Problem:
{problem}

Solution narrative:
{narrative}

Return ONLY a valid JSON object with this exact structure — no prose, no fences:
{{
  "objective": <the claimed optimal objective value as a number>,
  "variables": {{"<variable_name>": <value>, ...}},
  "obj_coefficients": {{"<variable_name>": <profit or cost per unit>, ...}},
  "constraints": [
    {{"name": "<resource name>", "coefficients": {{"<variable_name>": <amount per unit>}},
     "limit": <RHS number>, "op": "<= or >="}}
  ]
}}

Instructions:
- Extract all decision variable values from the solution (use the names from the problem).
- Extract each variable's profit/cost coefficient from the problem statement.
- List every resource constraint: for each constraint write how much of the resource
  each product consumes and the total available (limit).
- Use the objective value the narrative claims as the optimal.
$$;

CREATE FUNCTION interpret_solution(problem TEXT, solution_json TEXT, lang TEXT)
RETURNS TEXT AS $$
You are an operations research expert. Interpret this optimization result
for a business user.

Problem: {problem}

Optimal solution (JSON):
{solution_json}

Your response must have two sections:

## Interpretation
Concise interpretation (under 120 words):
1. What is the optimal decision? (which variable takes what value)
2. What is the optimal objective value?
3. Are any constraints binding (at their exact limit)?
4. One-sentence recommendation.

## Solution Verification
Walk through the math step by step to confirm the solution is correct:
- For each constraint in the problem, substitute the optimal variable values,
  compute the left-hand side, and show whether the constraint is satisfied
  (≤, ≥, or = the right-hand side) and whether it is binding (tight) or slack.
- Compute the objective value by substituting the optimal values and show the
  arithmetic explicitly (e.g. "3.6 × $20 + 3.2 × $30 = $72 + $96 = $168").
- State whether the computed objective matches the solver's reported value.

Use clear arithmetic notation. Write in {lang}. No JSON, no code.
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW constraint_opt
  -- Default: a two-product production planning problem with a known
  -- closed-form optimum (x=3.6 chairs, y=3.2 tables, profit=$168)
  -- that a human can verify by hand but which requires LP to prove optimal.
  INPUT @problem TEXT := "A bakery produces artisan bread and croissants. Each loaf of bread requires 3 hours of labor and 2 kg of flour, earning $12 profit. Each batch of croissants requires 1 hour of labor and 3 kg of flour, earning $8 profit. The bakery has 12 hours of labor and 15 kg of flour available each day. Both products must have non-negative quantities. Maximize daily profit."
  INPUT @use_solver TEXT := "true"
  INPUT @max_tries INTEGER := 3
  INPUT @lang TEXT := "English"
  INPUT @out_dir TEXT := "./cookbook/78_constraint_opt/output"
  OUTPUT @report TEXT
DO
  -- 0. Timing + run-id
  CALL time_monotonic() INTO @t_start;
  CALL time_now() INTO @ts_safe;
  LOGGING f"[constraint_opt] start  run_id={@ts_safe}  use_solver={@use_solver}" LEVEL INFO

  @llm_calls     := 0;
  @tries         := 0;
  @status        := "";
  @lp_code       := "";
  @solution      := "{}";
  @stage1_s      := "0";
  @stage2_s      := "0";
  @obj_str       := "";
  @verify_status := "N/A";
  @verify_result := "{}";

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- ── Stage 1: LLM formulates LP; PuLP solves; repair loop ──
      LOGGING "[constraint_opt] Stage 1 — LLM formulation + solver" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      @status := "init";

      WHILE @tries < @max_tries DO
        EVALUATE @status
          WHEN = "Optimal" THEN
            @tries := @max_tries;               -- solved: exit the loop

          WHEN = "init" THEN
            LOGGING "[constraint_opt] attempt 1 — LLM formulating LP code" LEVEL INFO
            GENERATE formulate_lp(@problem) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[constraint_opt] attempt {@tries}: status={@status}" LEVEL INFO

          ELSE
            CALL result_error(@solution) INTO @error_info;
            LOGGING f"[constraint_opt] repair {@tries} — feeding error to LLM: {@error_info}" LEVEL INFO
            GENERATE repair_lp(@problem, @lp_code, @error_info) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[constraint_opt] repair {@tries}: status={@status}" LEVEL INFO
        END;
      END;

      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[constraint_opt] Stage 1 done — latency={@stage1_s}s  llm_calls={@llm_calls}" LEVEL INFO

      -- ── Stage 2: deterministic correctness gate ───────────────
      -- ASSERT is the formal boundary: execution only continues when
      -- PuLP confirms Optimal. A non-Optimal status raises ToolFailed
      -- and is caught below — the solver's verdict is authoritative.
      LOGGING f"[constraint_opt] Stage 2 — ASSERT gate (status={@status})" LEVEL INFO
      ASSERT is_optimal(@solution);
      LOGGING "[constraint_opt] ASSERT passed — solver confirmed Optimal" LEVEL INFO
      LOGGING f"[constraint_opt] solver_input (lp_code):\n{@lp_code}" LEVEL DEBUG
      CALL json_get_objective(@solution) INTO @obj_str;
      LOGGING f"[constraint_opt] objective_claimed={@obj_str}  tokens_in={@_total_input_tokens}  tokens_out={@_total_output_tokens}" LEVEL INFO

      -- ── Stage 3: LLM interprets the verified result ───────────
      LOGGING "[constraint_opt] Stage 3 — LLM interpreting verified solution" LEVEL INFO
      CALL time_monotonic() INTO @t_s3;
      GENERATE interpret_solution(@problem, @solution, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s3) INTO @stage2_s;
      LOGGING f"[constraint_opt] Stage 3 done — latency={@stage2_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

    ELSE
      -- ── solver=OFF: LLM solves directly (ablation baseline) ───
      LOGGING "[constraint_opt] Stage 1 — LLM solving directly (no solver)" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      GENERATE solve_directly(@problem, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[constraint_opt] Stage 1 done — latency={@stage1_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

      -- ── Verification: back-substitute LLM solution ───────────
      LOGGING "[constraint_opt] verify_off — extracting solution JSON from narrative" LEVEL INFO
      GENERATE extract_solution_json(@problem, @narrative) INTO @claimed_json;
      @llm_calls := @llm_calls + 1;
      CALL verify_off_lp(@problem, @claimed_json) INTO @verify_result;
      CALL json_get_field(@verify_result, "verdict") INTO @verify_status;
      CALL json_get_field(@verify_result, "claimed_obj") INTO @obj_str;
      LOGGING f"[constraint_opt] verify_off: verdict={@verify_status}  result={@verify_result}" LEVEL INFO
      LOGGING f"[constraint_opt] objective_claimed={@obj_str}  tokens_in={@_total_input_tokens}  tokens_out={@_total_output_tokens}" LEVEL INFO
  END;

  CALL time_elapsed(@t_start) INTO @total_s;
  CALL make_metrics(@use_solver, @llm_calls, @stage1_s, @stage2_s, @total_s,
                    @_total_input_tokens, @_total_output_tokens) INTO @metrics;
  CALL format_report(@problem, @use_solver, @lp_code, @solution, @narrative, @metrics) INTO @report;

  CALL write_file(f"{@out_dir}/constraint_opt_{@ts_safe}.md", @report) INTO @out_path;
  LOGGING f"[constraint_opt] done — report → {@out_path}  ({@total_s}s, llm_calls={@llm_calls})" LEVEL INFO

  RETURN @report WITH status = "complete", objective = @obj_str, verify = @verify_status;

EXCEPTION
  WHEN ToolFailed THEN
    @report := "Solver did not reach Optimal status after " + @tries + " attempts. Last status: " + @status;
    CALL write_file(f"{@out_dir}/constraint_opt_{@ts_safe}.md", @report) INTO @out_path;
    CALL time_elapsed(@t_start) INTO @total_s;
    LOGGING f"[constraint_opt] infeasible — report → {@out_path}  ({@total_s}s)" LEVEL INFO
    RETURN @report WITH status = "infeasible", objective = "", verify = "N/A";
END;
