-- ============================================================
-- Recipe 78c: Staff Scheduling — Shift Assignment (ILP)
--
-- Domain: HR / operations — assign staff to shifts to meet
-- minimum coverage requirements at minimum wage cost.
--
-- PuLP problem type: Integer Linear Program (ILP)
--   en.wikipedia.org/wiki/Nurse_scheduling_problem
--
--   Decision variables : x[n][s] ∈ {0,1} — nurse n works shift s
--   Objective          : minimize Σ wage[s] · Σ_n x[n][s]
--   Constraints        :
--     coverage — Σ_n x[n][s] ≥ min_nurses[s]  for each shift s
--     workload — Σ_s x[n][s] ≤ 1              for each nurse n (1 shift/day)
--     x[n][s] ∈ {0, 1}  (binary — each nurse either works a shift or not)
--
-- Default problem (hand-verifiable):
--   5 nurses (N1–N5), each works at most 1 shift.
--   Coverage: Morning ≥ 2, Afternoon ≥ 2, Night ≥ 1 (total 5 min slots)
--   Wage per nurse: Morning $200, Afternoon $180, Night $320
--   Known optimal: $1,080
--     N1,N2 → Morning ($400) + N3,N4 → Afternoon ($360) + N5 → Night ($320)
--
-- use_solver="true"  → full deterministic pipeline (PuLP + ASSERT)
-- use_solver="false" → LLM-only baseline for ablation comparison
--
-- Run:
--   spl3 run cookbook/78_constraint_opt/staff_scheduling.spl --llm claude_cli
--   spl3 run cookbook/78_constraint_opt/staff_scheduling.spl --llm claude_cli \
--       --param use_solver=false
-- ============================================================

-- ── Deterministic regime: PuLP ILP solver ────────────────────

CREATE TOOL_API run_pulp(code TEXT)
RETURNS TEXT AS PYTHON $$
def run_pulp(code: str) -> str:
    import json, re, pulp
    code = re.sub(r'^```(?:python)?\s*\n?', '', code.strip(), flags=re.IGNORECASE)
    code = re.sub(r'\n?```\s*$', '', code)
    namespace = {"pulp": pulp}
    try:
        exec(code, namespace)
        result = namespace.get("_result")
        if result is None:
            return json.dumps({"status": "Error",
                               "error": "code did not set _result"})
        return json.dumps(result, default=str)
    except Exception as e:
        return json.dumps({"status": "Error", "error": str(e)})
$$;

CREATE TOOL_API is_optimal(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def is_optimal(result_json: str) -> bool:
    import json
    try:
        return json.loads(result_json).get("status") == "Optimal"
    except Exception:
        return False
$$;

CREATE TOOL_API make_metrics(use_solver TEXT, llm_calls TEXT,
                             stage1_s TEXT, stage2_s TEXT, total_s TEXT,
                             input_tokens TEXT, output_tokens TEXT)
RETURNS TEXT AS PYTHON $$
def make_metrics(use_solver: str, llm_calls: str,
                 stage1_s: str, stage2_s: str, total_s: str,
                 input_tokens: str, output_tokens: str) -> str:
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    mode      = "solver=ON  (PuLP/CBC + ASSERT gate)" if solver_on else "solver=OFF (LLM reasoning only)"
    s1_label  = "Stage 1 — formulation + solve (s)" if solver_on else "Stage 1 — direct LLM solve (s)"

    def fmt_f(v):
        try:
            return f"{float(v):.2f}"
        except Exception:
            return v or "—"

    def fmt_i(v):
        try:
            return f"{int(v):,}"
        except Exception:
            return v or "—"

    total_tok = "—"
    try:
        total_tok = f"{int(input_tokens) + int(output_tokens):,}"
    except Exception:
        pass

    rows = [
        ("Mode",                         mode),
        ("LLM calls",                    llm_calls),
        (s1_label,                       fmt_f(stage1_s)),
        ("Stage 2 — interpretation (s)", fmt_f(stage2_s) if solver_on else "—"),
        ("Total latency (s)",            fmt_f(total_s)),
        ("Input tokens",                 fmt_i(input_tokens)),
        ("Output tokens",                fmt_i(output_tokens)),
        ("Total tokens",                 total_tok),
    ]
    header = "| Metric | Value |"
    sep    = "|---|---|"
    lines  = [header, sep] + [f"| {k} | {v} |" for k, v in rows]
    return "\n".join(lines)
$$;

CREATE TOOL_API format_schedule(problem TEXT, use_solver TEXT, lp_code TEXT,
                                solution_json TEXT, narrative TEXT, metrics TEXT)
RETURNS TEXT AS PYTHON $$
def format_schedule(problem: str, use_solver: str, lp_code: str,
                    solution_json: str, narrative: str, metrics: str) -> str:
    import json
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    try:
        sol = json.loads(solution_json)
    except Exception:
        sol = {}
    status    = sol.get("status")
    objective = sol.get("objective")
    variables = sol.get("variables", {})

    lines = [
        "# Staff Scheduling Report",
        "",
        f"**Problem:** {problem.strip()}",
    ]
    if solver_on and status:
        lines += ["", f"**Solver status:** `{status}`"]
    if solver_on and objective is not None:
        lines.append(f"**Minimum total wage cost:** ${objective:.2f}")
    if solver_on and variables:
        lines += ["", "**Schedule (assigned shifts):**"]
        for var_name, val in variables.items():
            v = float(val) if not isinstance(val, (int, float)) else val
            if v > 0.5:
                lines.append(f"  - {var_name}: assigned")

    lines += ["", narrative.strip()]

    if solver_on and lp_code.strip():
        lines += ["", "## Solver Code (LLM-generated, PuLP)", "", "```python", lp_code.strip(), "```"]

    lines += ["", "## Run Metrics", "", metrics]
    return "\n".join(lines)
$$;

-- ── Probabilistic regime: LLM prompt templates ───────────────

CREATE FUNCTION formulate_scheduling_ilp(problem TEXT)
RETURNS TEXT AS $$
You are an operations research expert specializing in workforce scheduling.
Convert this staff scheduling problem to runnable PuLP Integer Linear Program (ILP) code.

Rules:
- The `pulp` module is already in scope — do NOT add import statements
- Model this as a binary ILP:
    * Create a pulp.LpProblem with sense=pulp.LpMinimize
    * Decision variables: x[nurse][shift] = binary (1 if nurse works shift, 0 otherwise)
      Use pulp.LpVariable(f"x_{nurse}_{shift}", cat='Binary')
    * Objective: minimize total wage cost = Σ wage[shift] · Σ_nurse x[nurse][shift]
    * Coverage constraints: for each shift s, sum of x[n][s] over all nurses >= min_nurses[s]
    * Workload constraints: for each nurse n, sum of x[n][s] over all shifts <= max_shifts_per_nurse
    * Call: prob.solve(pulp.PULP_CBC_CMD(msg=0))
- After solving, store the result EXACTLY as:
    _result = {
        "status": pulp.LpStatus[prob.status],
        "objective": pulp.value(prob.objective),
        "variables": {v.name: pulp.value(v) for v in prob.variables()}
    }
- Output ONLY raw Python code — no markdown fences, no commentary

Problem:
{problem}
$$;

CREATE FUNCTION repair_scheduling_ilp(problem TEXT, lp_code TEXT, error_info TEXT)
RETURNS TEXT AS $$
This PuLP staff scheduling ILP code produced an error or non-Optimal result.

Problem:
{problem}

Previous code:
{lp_code}

Error / solver status:
{error_info}

Fix the code. Common causes for scheduling ILPs:
- Forgot cat='Binary' on decision variables (treats them as continuous)
- Coverage constraint uses wrong direction (must be >=, not <=)
- Infeasible: total nurse capacity < total minimum coverage required
  → Check if sum of (max_shifts_per_nurse * num_nurses) >= sum of min_coverage
- Variable name typos in constraints
- Missing _result assignment

Output ONLY the corrected Python code — no markdown fences, no commentary.
$$;

CREATE FUNCTION solve_directly_staff(problem TEXT, lang TEXT)
RETURNS TEXT AS $$
You are an HR operations analyst. Solve this staff scheduling problem using
mathematical reasoning only — no solver software.

Problem: {problem}

Your response must have two sections:

## Solution
Work through the assignment step by step:
1. List all nurses, shifts, wages, and coverage requirements.
2. Calculate the minimum number of nurse-shifts needed and verify feasibility
   (total nurse capacity ≥ total minimum coverage).
3. Assign nurses to shifts to minimize total wage cost: start by filling the
   cheapest shifts first up to minimum coverage, then check if all constraints
   are satisfied. Enumerate alternatives if the greedy choice is ambiguous.
4. State the optimal assignment (which nurse goes to which shift) and the
   total minimum wage cost.

## Verification
Confirm the assignment is correct:
- For each shift, count the assigned nurses and confirm coverage ≥ minimum (show arithmetic).
- For each nurse, confirm they work at most the allowed number of shifts.
- Compute total wage cost step by step (nurses per shift × wage, then sum).

Write in {lang}. Show all arithmetic explicitly.
$$;

CREATE FUNCTION interpret_schedule(problem TEXT, solution_json TEXT, lang TEXT)
RETURNS TEXT AS $$
You are an HR operations analyst. Interpret this staff scheduling result for
a shift manager.

Problem:
{problem}

Optimal schedule (JSON — variables with value 1.0 are assigned):
{solution_json}

Your response must have two sections:

## Interpretation
Concise summary (under 150 words):
1. What is the total minimum wage cost for this shift plan?
2. Which nurses are assigned to which shifts?
3. Are minimum coverage requirements exactly met, or does any shift have extra staff?
4. One practical suggestion for the manager (e.g., cross-training, standby roster).

## Solution Verification
Walk through the math to confirm correctness:
- For each shift, count assigned nurses and confirm coverage ≥ minimum (show arithmetic).
- For each nurse, confirm they work at most the allowed number of shifts.
- Compute total wage cost step by step (nurses per shift × wage, then sum).
- Confirm the computed cost matches the solver's reported value.

Write in {lang}. No JSON, no code.
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW staff_scheduling
  INPUT @problem TEXT := "A clinic needs to staff one day with 3 shifts: Morning, Afternoon, and Night. Minimum nurse coverage required: Morning needs at least 2 nurses, Afternoon needs at least 2 nurses, Night needs at least 1 nurse. Five nurses are available (Nurse1 through Nurse5). Each nurse can work at most 1 shift today. Wage per nurse-shift: Morning costs $200, Afternoon costs $180, Night costs $320. Assign nurses to shifts to meet all minimum coverage requirements at minimum total wage cost."
  INPUT @use_solver TEXT := "true"
  INPUT @max_tries INTEGER := 3
  INPUT @lang TEXT := "English"
  INPUT @out_dir TEXT := "./cookbook/78_constraint_opt/output"
  OUTPUT @report TEXT
DO
  CALL time_monotonic() INTO @t_start;
  CALL time_now() INTO @ts_safe;
  LOGGING f"[staff_scheduling] start  ts={@ts_safe}  use_solver={@use_solver}" LEVEL INFO

  @llm_calls := 0;
  @tries     := 0;
  @status    := "";
  @lp_code   := "";
  @solution  := "{}";
  @stage1_s  := "0";
  @stage2_s  := "0";

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- ── Stage 1: LLM formulates ILP; PuLP solves; repair loop ──
      LOGGING "[staff_scheduling] Stage 1 — LLM formulation + solver" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      @status := "init";

      WHILE @tries < @max_tries DO
        EVALUATE @status
          WHEN = "Optimal" THEN
            @tries := @max_tries;

          WHEN = "init" THEN
            LOGGING "[staff_scheduling] attempt 1 — LLM formulating scheduling ILP" LEVEL INFO
            GENERATE formulate_scheduling_ilp(@problem) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[staff_scheduling] attempt {@tries}: status={@status}" LEVEL INFO

          ELSE
            CALL result_error(@solution) INTO @error_info;
            LOGGING f"[staff_scheduling] repair {@tries} — error: {@error_info}" LEVEL INFO
            GENERATE repair_scheduling_ilp(@problem, @lp_code, @error_info) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[staff_scheduling] repair {@tries}: status={@status}" LEVEL INFO
        END;
      END;

      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[staff_scheduling] Stage 1 done — latency={@stage1_s}s  llm_calls={@llm_calls}" LEVEL INFO

      -- ── Stage 2: deterministic gate ───────────────────────────
      LOGGING f"[staff_scheduling] ASSERT gate (status={@status})" LEVEL INFO
      ASSERT is_optimal(@solution);
      LOGGING "[staff_scheduling] ASSERT passed — schedule confirmed Optimal" LEVEL INFO

      -- ── Stage 3: LLM interprets verified result ───────────────
      LOGGING "[staff_scheduling] Stage 3 — LLM interpreting verified schedule" LEVEL INFO
      CALL time_monotonic() INTO @t_s3;
      GENERATE interpret_schedule(@problem, @solution, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s3) INTO @stage2_s;
      LOGGING f"[staff_scheduling] Stage 3 done — latency={@stage2_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

    ELSE
      -- ── solver=OFF: LLM solves directly (ablation baseline) ───
      LOGGING "[staff_scheduling] Stage 1 — LLM solving directly (no solver)" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      GENERATE solve_directly_staff(@problem, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[staff_scheduling] Stage 1 done — latency={@stage1_s}s  total_llm_calls={@llm_calls}" LEVEL INFO
  END;

  CALL time_elapsed(@t_start) INTO @total_s;
  CALL make_metrics(@use_solver, @llm_calls, @stage1_s, @stage2_s, @total_s,
                    @_total_input_tokens, @_total_output_tokens) INTO @metrics;
  CALL format_schedule(@problem, @use_solver, @lp_code, @solution, @narrative, @metrics) INTO @report;

  CALL write_file(f"{@out_dir}/staff_scheduling_{@ts_safe}.md", @report) INTO @out_path;
  LOGGING f"[staff_scheduling] done — report → {@out_path}  ({@total_s}s, llm_calls={@llm_calls})" LEVEL INFO

  RETURN @report WITH status = "complete";

EXCEPTION
  WHEN ToolFailed THEN
    @report := "Scheduler could not find Optimal assignment after " + @tries + " attempts. Last status: " + @status;
    CALL write_file(f"{@out_dir}/staff_scheduling_{@ts_safe}.md", @report) INTO @out_path;
    CALL time_elapsed(@t_start) INTO @total_s;
    LOGGING f"[staff_scheduling] infeasible — {@out_path}  ({@total_s}s)" LEVEL INFO
    RETURN @report WITH status = "infeasible";
END;
