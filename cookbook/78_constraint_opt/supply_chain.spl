-- ============================================================
-- Recipe 78b: Supply Chain — Transportation Cost Minimization
--
-- Domain: Supply chain / logistics — ship goods from warehouses
-- to retail stores at minimum cost.
--
-- PuLP problem type: Linear Program (LP)
--   en.wikipedia.org/wiki/Transportation_theory_(mathematics)
--
--   Decision variables : x[i][j] = units shipped from warehouse i to store j
--   Objective          : minimize Σ cost[i][j] · x[i][j]
--   Constraints        :
--     supply  — Σ_j x[i][j] ≤ supply[i]  for each warehouse i
--     demand  — Σ_i x[i][j] = demand[j]  for each store j
--     non-neg — x[i][j] ≥ 0
--
-- Default problem (balanced, hand-verifiable):
--   Warehouses : W1 (80 units), W2 (60 units)   total supply = 140
--   Stores     : S1 (50 units), S2 (40 units), S3 (50 units)  total demand = 140
--   Cost matrix ($/unit):
--     W1→S1 $2, W1→S2 $3, W1→S3 $1
--     W2→S1 $5, W2→S2 $4, W2→S3 $8
--   Known optimal : $370
--     W1→S3: 50, W1→S1: 30, W2→S1: 20, W2→S2: 40
--     Verify: 50×1 + 30×2 + 20×5 + 40×4 = 50+60+100+160 = $370
--
-- use_solver="true"  → full deterministic pipeline (PuLP + ASSERT)
-- use_solver="false" → LLM-only baseline for ablation comparison
--
-- Run:
--   spl3 run cookbook/78_constraint_opt/supply_chain.spl --llm claude_cli
--   spl3 run cookbook/78_constraint_opt/supply_chain.spl --llm claude_cli \
--       --param use_solver=false
-- ============================================================

-- ── Deterministic regime: PuLP solver tools ──────────────────

CREATE TOOL_API run_pulp(code TEXT)
RETURNS TEXT AS PYTHON $$
def run_pulp(code: str) -> str:
    """Execute LLM-generated PuLP transportation LP and return JSON result.

    Returns {"status": "Optimal", "objective": <total_cost>, "variables": {...}}
    On any error returns {"status": "Error", "error": "<msg>"}.
    """
    import json, re, pulp
    code = re.sub(r'^```(?:python)?\s*\n?', '', code.strip(), flags=re.IGNORECASE)
    code = re.sub(r'\n?```\s*$', '', code)
    code = re.sub(r'(?m)^\s*import\s+pulp\s*(?:#.*)?$', '', code)
    code = re.sub(r'(?m)^\s*from\s+pulp\s+import\s+.*$', '', code)
    code = code.replace('pulp.pulp.LpStatus', 'pulp.LpStatus')
    namespace = {"pulp": pulp}
    namespace.update({k: getattr(pulp, k) for k in dir(pulp) if not k.startswith('_') and k != 'pulp'})
    try:
        exec(code, namespace)
        result = namespace.get("_result")
        if result is None:
            return json.dumps({"status": "Error",
                               "error": "code did not set _result"})
        return json.dumps(result, default=str)
    except Exception as e:
        return json.dumps({"status": "Error", "error": str(e)})
$$;

CREATE TOOL_API is_optimal(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def is_optimal(result_json: str) -> bool:
    import json
    try:
        return json.loads(result_json).get("status") == "Optimal"
    except Exception:
        return False
$$;

CREATE TOOL_API json_get_objective(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_objective(result_json: str) -> str:
    import json
    try:
        v = json.loads(result_json).get("objective")
        return str(v) if v is not None else ""
    except Exception:
        return ""
$$;

CREATE TOOL_API json_get_field(result_json TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_field(result_json: str, field: str) -> str:
    import json
    try:
        v = json.loads(result_json).get(field)
        return str(v) if v is not None else ""
    except Exception:
        return ""
$$;

CREATE TOOL_API verify_off_transport(problem TEXT, claimed_json TEXT)
RETURNS TEXT AS PYTHON $$
def verify_off_transport(problem: str, claimed_json: str) -> str:
    import json, re
    raw = claimed_json.strip()
    raw = re.sub(r'^```(?:json)?\s*\n?', '', raw, flags=re.IGNORECASE)
    raw = re.sub(r'\n?```\s*$', '', raw)
    try:
        claimed = json.loads(raw)
    except Exception as e:
        return json.dumps({"verdict": "UNPARSEABLE", "notes": f"JSON error: {e}",
                           "raw_prefix": claimed_json[:120]})

    obj_claimed = claimed.get("objective")
    routes      = claimed.get("routes", {})     # {"W1_S1": qty, ...}
    supply      = claimed.get("supply", {})     # {"W1": cap, ...}
    demand      = claimed.get("demand", {})     # {"S1": req, ...}
    costs       = claimed.get("costs", {})      # {"W1_S1": cost_per_unit, ...}

    violations = []

    for wh, cap in supply.items():
        shipped = sum(float(q) for r, q in routes.items() if r.startswith(wh + "_"))
        if shipped > float(cap) + 0.001:
            violations.append(f"{wh} supply violated: {shipped:.2f} > {cap}")

    for st, req in demand.items():
        received = sum(float(q) for r, q in routes.items() if r.endswith("_" + st))
        if abs(received - float(req)) > 0.001:
            violations.append(f"{st} demand unmet: {received:.2f} != {req}")

    for route, qty in routes.items():
        if float(qty) < -0.001:
            violations.append(f"{route} negative: {qty}")

    if costs and routes:
        try:
            recomputed = sum(float(costs.get(r, 0)) * float(q) for r, q in routes.items())
            if obj_claimed is not None and abs(recomputed - float(obj_claimed)) > 0.5:
                violations.append(f"cost mismatch: claimed {obj_claimed} vs computed {recomputed:.2f}")
        except Exception as e:
            violations.append(f"cost recompute error: {e}")

    if violations:
        return json.dumps({"verdict": "FAIL", "claimed_obj": obj_claimed,
                           "notes": "; ".join(violations)})
    if not routes:
        return json.dumps({"verdict": "UNPARSEABLE", "claimed_obj": obj_claimed,
                           "notes": "no routes in JSON"})
    return json.dumps({"verdict": "PASS", "claimed_obj": obj_claimed,
                       "notes": f"{len(routes)} routes verified"})
$$;

CREATE TOOL_API make_metrics(use_solver TEXT, llm_calls TEXT,
                             stage1_s TEXT, stage2_s TEXT, total_s TEXT,
                             input_tokens TEXT, output_tokens TEXT)
RETURNS TEXT AS PYTHON $$
def make_metrics(use_solver: str, llm_calls: str,
                 stage1_s: str, stage2_s: str, total_s: str,
                 input_tokens: str, output_tokens: str) -> str:
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    mode      = "solver=ON  (PuLP/CBC + ASSERT gate)" if solver_on else "solver=OFF (LLM reasoning only)"
    s1_label  = "Stage 1 — formulation + solve (s)" if solver_on else "Stage 1 — direct LLM solve (s)"

    def fmt_f(v):
        try:
            return f"{float(v):.2f}"
        except Exception:
            return v or "—"

    def fmt_i(v):
        try:
            return f"{int(v):,}"
        except Exception:
            return v or "—"

    total_tok = "—"
    try:
        total_tok = f"{int(input_tokens) + int(output_tokens):,}"
    except Exception:
        pass

    rows = [
        ("Mode",                         mode),
        ("LLM calls",                    llm_calls),
        (s1_label,                       fmt_f(stage1_s)),
        ("Stage 2 — interpretation (s)", fmt_f(stage2_s) if solver_on else "—"),
        ("Total latency (s)",            fmt_f(total_s)),
        ("Input tokens",                 fmt_i(input_tokens)),
        ("Output tokens",                fmt_i(output_tokens)),
        ("Total tokens",                 total_tok),
    ]
    header = "| Metric | Value |"
    sep    = "|---|---|"
    lines  = [header, sep] + [f"| {k} | {v} |" for k, v in rows]
    return "\n".join(lines)
$$;

CREATE TOOL_API format_report(problem TEXT, use_solver TEXT, lp_code TEXT,
                              solution_json TEXT, narrative TEXT, metrics TEXT)
RETURNS TEXT AS PYTHON $$
def format_report(problem: str, use_solver: str, lp_code: str,
                  solution_json: str, narrative: str, metrics: str) -> str:
    import json
    solver_on = use_solver.strip().lower() in ("true", "1", "yes")
    try:
        sol = json.loads(solution_json)
    except Exception:
        sol = {}
    status    = sol.get("status")
    objective = sol.get("objective")
    variables = sol.get("variables", {})

    lines = [
        "# Supply Chain Optimization Report",
        "",
        f"**Problem:** {problem.strip()}",
    ]
    if solver_on and status:
        lines += ["", f"**Solver status:** `{status}`"]
    if solver_on and objective is not None:
        lines.append(f"**Minimum total shipping cost:** ${objective:.2f}")
    if solver_on and variables:
        lines += ["", "**Shipping plan (units):**"]
        for route, qty in variables.items():
            val = float(qty) if not isinstance(qty, (int, float)) else qty
            if val > 1e-6:
                lines.append(f"  - {route}: {val:.4g} units")

    lines += ["", narrative.strip()]

    if solver_on and lp_code.strip():
        lines += ["", "## Solver Code (LLM-generated, PuLP)", "", "```python", lp_code.strip(), "```"]

    lines += ["", "## Run Metrics", "", metrics]
    return "\n".join(lines)
$$;

-- ── Probabilistic regime: LLM prompt templates ───────────────

CREATE FUNCTION formulate_transport_lp(problem TEXT)
RETURNS TEXT AS $$
You are an operations research expert specializing in supply chain optimization.
Convert this transportation / shipping problem to runnable PuLP Python code.

Rules:
- The `pulp` module is already in scope — do NOT add import statements
- Model this as a transportation LP:
    * Create a pulp.LpProblem with sense=pulp.LpMinimize
    * Decision variables: x[i][j] = units shipped from source i to destination j
      Use pulp.LpVariable(f"x_{i}_{j}", lowBound=0)
    * Objective: minimize total shipping cost = Σ cost[i][j] * x[i][j]
    * Supply constraints: for each source i, Σ_j x[i][j] <= supply[i]
    * Demand constraints: for each destination j, Σ_i x[i][j] == demand[j]
    * Call: prob.solve(pulp.PULP_CBC_CMD(msg=0))
- After solving, store the result EXACTLY as:
    _result = {
        "status": pulp.LpStatus[prob.status],
        "objective": pulp.value(prob.objective),
        "variables": {v.name: pulp.value(v) for v in prob.variables()}
    }
- Output ONLY raw Python code — no markdown fences, no commentary

Problem:
{problem}
$$;

CREATE FUNCTION repair_transport_lp(problem TEXT, lp_code TEXT, error_info TEXT)
RETURNS TEXT AS $$
This PuLP transportation LP code produced an error or non-Optimal result.

Problem:
{problem}

Previous code:
{lp_code}

Error / solver status:
{error_info}

Fix the code. Common causes for transportation LPs:
- Demand exceeds total supply (infeasible) — check if supply >= demand
- Wrong constraint direction (use <= for supply, == for demand)
- Variable indexing errors (mismatched source/destination names)
- Missing _result assignment at the end
- Unbalanced problem: if total supply > total demand, use <= for demand constraints instead of ==

Output ONLY the corrected Python code — no markdown fences, no commentary.
$$;

CREATE FUNCTION solve_directly_supply_chain(problem TEXT, lang TEXT)
RETURNS TEXT AS $$
You are a supply chain analyst. Solve this transportation cost minimization problem
using mathematical reasoning only — no solver software.

Problem: {problem}

Your response must have two sections:

## Solution
Work through the transportation problem step by step:
1. Set up the cost matrix and supply/demand table.
2. Apply the Minimum Cost Method (or Northwest Corner + MODI) to find an initial
   feasible solution, then improve it until no further cost reduction is possible.
3. State the optimal shipping plan: which routes carry how many units, and the
   total minimum cost.

## Verification
Plug the optimal plan back in and confirm:
- Each supply constraint is satisfied (show arithmetic, label binding or slack).
- Each demand constraint is exactly met (show arithmetic).
- Compute total cost step by step (e.g. "50×$1 + 30×$2 + ... = $370").

Write in {lang}. Show all arithmetic explicitly.
$$;

CREATE FUNCTION extract_solution_json_transport(problem TEXT, narrative TEXT)
RETURNS TEXT AS $$
Extract the transportation solution from the narrative as structured JSON.

Problem:
{problem}

Solution narrative:
{narrative}

Return ONLY a valid JSON object — no prose, no fences:
{{
  "objective": <total shipping cost as a number>,
  "routes": {{"<Wi_Sj>": <quantity shipped>, ...}},
  "supply": {{"<Wi>": <capacity>, ...}},
  "demand": {{"<Sj>": <requirement>, ...}},
  "costs": {{"<Wi_Sj>": <cost per unit>, ...}}
}}

Instructions:
- Name routes using the format "W1_S1" (warehouse underscore store).
- Extract all warehouse supply capacities and store demand requirements from the problem.
- Extract all unit shipping costs from the cost matrix in the problem.
- Use the total shipping cost the narrative claims as "objective".
$$;

CREATE FUNCTION interpret_shipping_plan(problem TEXT, solution_json TEXT, lang TEXT)
RETURNS TEXT AS $$
You are a supply chain analyst. Interpret this shipping optimization result for
a logistics manager.

Problem:
{problem}

Optimal solution (JSON):
{solution_json}

Your response must have two sections:

## Interpretation
Concise summary (under 150 words):
1. What is the total minimum shipping cost?
2. Which routes carry the most volume? Which routes are unused and why?
3. Are any warehouse capacities fully used (binding constraints)?
4. One practical recommendation for the logistics team.

## Solution Verification
Walk through the math to confirm correctness:
- For each supply constraint, substitute the route quantities and show whether
  it is binding (fully used) or has slack (unused capacity).
- For each demand constraint, show that total inbound units = demand exactly.
- Compute total shipping cost step by step (route × cost per unit, then sum).
- Confirm the computed cost matches the solver's reported value.

Write in {lang}. No JSON, no code.
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW supply_chain
  INPUT @problem TEXT := "A company has two warehouses and three retail stores. Warehouse W1 has 80 units of inventory; Warehouse W2 has 60 units. Store S1 needs 50 units, Store S2 needs 40 units, Store S3 needs 50 units. Shipping costs per unit: W1 to S1 costs $2, W1 to S2 costs $3, W1 to S3 costs $1; W2 to S1 costs $5, W2 to S2 costs $4, W2 to S3 costs $8. All store demand must be met exactly. Minimize total shipping cost."
  INPUT @use_solver TEXT := "true"
  INPUT @max_tries INTEGER := 3
  INPUT @lang TEXT := "English"
  INPUT @out_dir TEXT := "./cookbook/78_constraint_opt/output"
  OUTPUT @report TEXT
DO
  CALL time_monotonic() INTO @t_start;
  CALL time_now() INTO @ts_safe;
  LOGGING f"[supply_chain] start  ts={@ts_safe}  use_solver={@use_solver}" LEVEL INFO

  @llm_calls := 0;
  @tries     := 0;
  @status    := "";
  @lp_code   := "";
  @solution  := "{}";
  @stage1_s  := "0";
  @stage2_s      := "0";
  @obj_str       := "";
  @verify_status := "N/A";
  @verify_result := "{}";

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- ── Stage 1: LLM formulates LP; PuLP solves; repair loop ──
      LOGGING "[supply_chain] Stage 1 — LLM formulation + solver" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      @status := "init";

      WHILE @tries < @max_tries DO
        EVALUATE @status
          WHEN = "Optimal" THEN
            @tries := @max_tries;

          WHEN = "init" THEN
            LOGGING "[supply_chain] attempt 1 — LLM formulating transportation LP" LEVEL INFO
            GENERATE formulate_transport_lp(@problem) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[supply_chain] attempt {@tries}: status={@status}" LEVEL INFO

          ELSE
            CALL result_error(@solution) INTO @error_info;
            LOGGING f"[supply_chain] repair {@tries} — error: {@error_info}" LEVEL INFO
            GENERATE repair_transport_lp(@problem, @lp_code, @error_info) INTO @lp_code;
            @llm_calls := @llm_calls + 1;
            CALL run_pulp(@lp_code) INTO @solution;
            CALL result_status(@solution) INTO @status;
            @tries := @tries + 1;
            LOGGING f"[supply_chain] repair {@tries}: status={@status}" LEVEL INFO
        END;
      END;

      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[supply_chain] Stage 1 done — latency={@stage1_s}s  llm_calls={@llm_calls}" LEVEL INFO

      -- ── Stage 2: deterministic gate ───────────────────────────
      LOGGING f"[supply_chain] ASSERT gate (status={@status})" LEVEL INFO
      ASSERT is_optimal(@solution);
      LOGGING "[supply_chain] ASSERT passed — minimum cost route confirmed" LEVEL INFO
      LOGGING f"[supply_chain] solver_input (lp_code):\n{@lp_code}" LEVEL DEBUG
      CALL json_get_objective(@solution) INTO @obj_str;
      LOGGING f"[supply_chain] objective_claimed={@obj_str}  tokens_in={@_total_input_tokens}  tokens_out={@_total_output_tokens}" LEVEL INFO

      -- ── Stage 3: LLM interprets verified result ───────────────
      LOGGING "[supply_chain] Stage 3 — LLM interpreting verified shipping plan" LEVEL INFO
      CALL time_monotonic() INTO @t_s3;
      GENERATE interpret_shipping_plan(@problem, @solution, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s3) INTO @stage2_s;
      LOGGING f"[supply_chain] Stage 3 done — latency={@stage2_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

    ELSE
      -- ── solver=OFF: LLM solves directly (ablation baseline) ───
      LOGGING "[supply_chain] Stage 1 — LLM solving directly (no solver)" LEVEL INFO
      CALL time_monotonic() INTO @t_s1;
      GENERATE solve_directly_supply_chain(@problem, @lang) INTO @narrative;
      @llm_calls := @llm_calls + 1;
      CALL time_elapsed(@t_s1) INTO @stage1_s;
      LOGGING f"[supply_chain] Stage 1 done — latency={@stage1_s}s  total_llm_calls={@llm_calls}" LEVEL INFO

      -- ── Verification: back-substitute LLM solution ───────────
      LOGGING "[supply_chain] verify_off — extracting solution JSON from narrative" LEVEL INFO
      GENERATE extract_solution_json_transport(@problem, @narrative) INTO @claimed_json;
      @llm_calls := @llm_calls + 1;
      CALL verify_off_transport(@problem, @claimed_json) INTO @verify_result;
      CALL json_get_field(@verify_result, "verdict") INTO @verify_status;
      CALL json_get_field(@verify_result, "claimed_obj") INTO @obj_str;
      LOGGING f"[supply_chain] verify_off: verdict={@verify_status}  result={@verify_result}" LEVEL INFO
      LOGGING f"[supply_chain] objective_claimed={@obj_str}  tokens_in={@_total_input_tokens}  tokens_out={@_total_output_tokens}" LEVEL INFO
  END;

  CALL time_elapsed(@t_start) INTO @total_s;
  CALL make_metrics(@use_solver, @llm_calls, @stage1_s, @stage2_s, @total_s,
                    @_total_input_tokens, @_total_output_tokens) INTO @metrics;
  CALL format_report(@problem, @use_solver, @lp_code, @solution, @narrative, @metrics) INTO @report;

  CALL write_file(f"{@out_dir}/supply_chain_{@ts_safe}.md", @report) INTO @out_path;
  LOGGING f"[supply_chain] done — report → {@out_path}  ({@total_s}s, llm_calls={@llm_calls})" LEVEL INFO

  RETURN @report WITH status = "complete", objective = @obj_str, verify = @verify_status;

EXCEPTION
  WHEN ToolFailed THEN
    @report := "Solver did not reach Optimal status after " + @tries + " attempts. Last status: " + @status;
    CALL write_file(f"{@out_dir}/supply_chain_{@ts_safe}.md", @report) INTO @out_path;
    CALL time_elapsed(@t_start) INTO @total_s;
    LOGGING f"[supply_chain] infeasible — {@out_path}  ({@total_s}s)" LEVEL INFO
    RETURN @report WITH status = "infeasible", objective = "", verify = "N/A";
END;
