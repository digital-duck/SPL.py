-- ============================================================
-- Recipe 107: Workforce 3-Objective Scheduling (cost, quality, risk)
--
-- Benchmark B4 — first 3D Pareto surface recipe in the suite.
-- Optimizes shift staffing across three objectives simultaneously:
--   1. Minimize total cost
--   2. Maximize blended service quality
--   3. Minimize blended fatigue risk
--
-- Solver: pymoo NSGA-II (integer variables)
--
-- Mirrors solver=ON / solver=OFF ablation pattern of r78.
--
-- use_solver="true"  → NSGA-II 3-objective Pareto surface
-- use_solver="false" → LLM-only baseline with back-substitution check
--
-- Requires: pip install pymoo pulp
-- Run:
--   spl3 run cookbook/107_workforce_3obj/workforce_3obj.spl \
--       --adapter claude_cli --param use_solver=true
--   spl3 run cookbook/107_workforce_3obj/workforce_3obj.spl \
--       --adapter claude_cli --param use_solver=false
-- ============================================================

-- ── TOOL_API wrappers ─────────────────────────────────────────

CREATE TOOL_API solve_workforce_pareto(problem_json TEXT, n_gen TEXT, pop_size TEXT)
RETURNS TEXT AS PYTHON $$
def solve_workforce_pareto(problem_json: str, n_gen: str, pop_size: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "107_workforce_3obj")
    if _dir not in sys.path:
        sys.path.insert(0, _dir)
    from tools import solve_workforce_pareto as _fn
    return _fn(problem_json, n_gen=int(n_gen), pop_size=int(pop_size))
$$;

CREATE TOOL_API is_pareto_feasible(front_json TEXT)
RETURNS TEXT AS PYTHON $$
def is_pareto_feasible(front_json: str) -> bool:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "107_workforce_3obj")
    if _dir not in sys.path:
        sys.path.insert(0, _dir)
    from tools import is_pareto_feasible as _fn
    return _fn(front_json)
$$;

