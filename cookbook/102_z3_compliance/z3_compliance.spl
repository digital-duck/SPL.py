-- ============================================================
-- Recipe 102: Z3 SMT Compliance Checker
--
-- PURPOSE: Encode business eligibility rules as Z3 SMT
-- constraints and determine whether the policy is satisfiable
-- (SAT → qualifying profile exists) or contradictory
-- (UNSAT → no customer can ever qualify).
--
-- KEY STORY: Five interconnected loan-eligibility rules create
-- a hidden constraint: a self-employed applicant with income
-- $40K–$49K is ineligible even with a 700 credit score —
-- UNLESS they have collateral (R3 ∧ ¬collateral → income≥50K
-- which conflicts with ¬R2 unless collateral). Z3 surfaces this
-- automatically; LLM traces rules linearly and misses it.
--
-- solver=ON  : Z3 finds SAT/UNSAT + qualifying profile
-- solver=OFF : LLM traces rules manually
--
-- Install: pip install z3-solver
--
-- Run:
--   spl3 run cookbook/102_z3_compliance/z3_compliance.spl \
--       --adapter claude_cli --param use_solver=true
--
--   spl3 run cookbook/102_z3_compliance/z3_compliance.spl \
--       --adapter ollama -m gemma3 --param use_solver=false
-- ============================================================

-- ── Tool APIs ────────────────────────────────────────────────

CREATE TOOL_API extract_policy(policy_text TEXT)
RETURNS TEXT AS PYTHON $$
def extract_policy(policy_text: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "102_z3_compliance")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import extract_policy as _fn
    return _fn(policy_text)
$$;

CREATE TOOL_API check_z3_eligibility(policy_json TEXT)
RETURNS TEXT AS PYTHON $$
def check_z3_eligibility(policy_json: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "102_z3_compliance")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import check_z3_eligibility as _fn
    return _fn(policy_json)
$$;

CREATE TOOL_API is_satisfiable(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def is_satisfiable(result_json: str) -> bool:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "102_z3_compliance")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import is_satisfiable as _fn
    return _fn(result_json)
$$;

CREATE TOOL_API format_z3_report(result_json TEXT, policy_json TEXT)
RETURNS TEXT AS PYTHON $$
def format_z3_report(result_json: str, policy_json: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "102_z3_compliance")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import format_z3_report as _fn
    return _fn(result_json, policy_json)
$$;

CREATE TOOL_API json_get_field(data_json TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_field(data_json: str, field: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "102_z3_compliance")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import json_get_field as _fn
    return _fn(data_json, field)
$$;

-- ── LLM prompt templates ─────────────────────────────────────

CREATE FUNCTION interpret_policy_prompt(policy_text TEXT)
RETURNS TEXT AS $$
You are a compliance analyst reviewing a loan eligibility policy.

POLICY TEXT:
{policy_text}

The policy has the following eligibility rules:
R1: Applicant must be 18 or older
R2: Annual income >= $30,000 OR has collateral
R3: If self-employed, then annual income >= $50,000
R4: Credit score >= 650 OR (credit score >= 600 AND income >= $80,000)
R5: Employed for >= 12 months OR has collateral

Task: Manually trace through the rules and determine:
1. Is this policy satisfiable — does a qualifying customer profile exist?
2. If yes, give ONE example of a customer who would qualify (specify all variable values).
3. Are there any hidden interactions between rules that could trap a customer?
4. What is the most restrictive edge case?

Be specific with numbers. Do not use Z3 or any solver — reason manually.
$$;

CREATE FUNCTION explain_z3_result_prompt(z3_report TEXT, policy_text TEXT)
RETURNS TEXT AS $$
You are a compliance analyst. Z3 (an SMT theorem prover) just verified this loan eligibility policy.

POLICY:
{policy_text}

Z3 RESULT:
{z3_report}

Explain the result in plain English for a business audience (≤150 words):
1. What did Z3 find?
2. What does this mean for the business? (e.g. are the rules consistent? contradictory?)
3. If Z3 found a qualifying profile, what is notable about it?
4. What would be the risk of relying on manual rule-tracing (solver=OFF) instead?
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW z3_compliance
  INPUT @policy_text TEXT := "QuickLoan eligibility policy: applicants must be 18+, have income >= $30K or collateral, credit score >= 650 (or 600 with income >= $80K), be employed 12+ months or have collateral, and if self-employed must earn >= $50K."
  INPUT @use_solver TEXT := "true"
  OUTPUT @report TEXT
DO
  LOGGING "[r102] z3_compliance start" LEVEL INFO

  CALL extract_policy(@policy_text) INTO @policy_json;

  EVALUATE @use_solver
    WHEN "true" THEN
      -- solver=ON: Z3 SMT theorem prover
      CALL check_z3_eligibility(@policy_json) INTO @z3_result;
      ASSERT is_satisfiable(@z3_result);
      CALL format_z3_report(@z3_result, @policy_json) INTO @solver_report;
      CALL json_get_field(@z3_result, "status") INTO @sat_status;
      LOGGING f"[r102] Z3 result: {@sat_status}" LEVEL INFO;
      GENERATE explain_z3_result_prompt(@solver_report, @policy_text) INTO @explanation;
      @report := f"=== Z3 Compliance Checker (r102) | solver=ON ===

{@solver_report}

── Business Explanation ────────────────────────────────────
{@explanation}"

    WHEN "false" THEN
      -- solver=OFF: LLM manual rule tracing
      GENERATE interpret_policy_prompt(@policy_text) INTO @llm_analysis;
      @report := f"=== Z3 Compliance Checker (r102) | solver=OFF ===

── LLM Manual Rule Analysis ────────────────────────────────
{@llm_analysis}

Note: solver=OFF relies on LLM sequential rule tracing. Run with --param use_solver=true
to verify with Z3 (finds hidden rule interactions the LLM misses)."
  END;

  RETURN @report WITH status = "complete", use_solver = @use_solver;

END;
