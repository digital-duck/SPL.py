-- ============================================================
-- Recipe 108: Robust Supply Chain MILP — python-mip + scenarios
--
-- Two-stage stochastic MILP: commit to a capacity investment NOW,
-- then observe which demand scenario materializes and respond.
--
-- Stage 1 (now):   binary build-vs-lease decision
-- Stage 2 (later): produce + emergency sourcing per scenario
--
-- Key story: naive expected-demand heuristic says BUILD (E[D]=190 > 150).
-- MILP prices all scenarios simultaneously and finds LEASE is cheaper.
-- The solver catches what intuition misses.
--
-- use_solver="true"  → python-mip two-stage stochastic MILP
-- use_solver="false" → naive expected-demand heuristic (often wrong)
--
-- Requires: pip install python-mip
-- Run:
--   spl3 run cookbook/108_robust_milp/robust_milp.spl \
--       --adapter claude_cli --param use_solver=true
--   spl3 run cookbook/108_robust_milp/robust_milp.spl \
--       --adapter ollama -m gemma3 --param use_solver=false
-- ============================================================

-- ── Python tool wrappers ──────────────────────────────────────

CREATE TOOL_API extract_robust_problem(problem TEXT)
RETURNS TEXT AS PYTHON $$
def extract_robust_problem(problem: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "108_robust_milp")
    if _dir not in sys.path:
        sys.path.insert(0, _dir)
    from tools import extract_robust_problem as _fn
    return _fn(problem)
$$;

CREATE TOOL_API solve_robust_milp(problem_json TEXT)
RETURNS TEXT AS PYTHON $$
def solve_robust_milp(problem_json: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "108_robust_milp")
    if _dir not in sys.path:
        sys.path.insert(0, _dir)
    from tools import solve_robust_milp as _fn
    return _fn(problem_json)
$$;

