-- ============================================================
-- Recipe 121: Platypus MOEA 3-Objective Workforce Scheduling (S020)
--
-- Same B4 benchmark as r107 (pymoo), solved with platypus NSGA-II —
-- a pure-Python lighter-weight MOEA library.
--
-- Objectives (all three simultaneously):
--   1. Minimize total cost
--   2. Maximize blended service quality
--   3. Minimize blended fatigue risk
--
-- Solver: platypus NSGA-II (Integer variables, native Python)
--
-- use_solver="true"  → platypus NSGA-II 3-objective Pareto surface
-- use_solver="false" → LLM-only baseline with back-substitution check
--
-- Requires: pip install platypus-opt pulp
-- Run:
--   spl3 run cookbook/121_platypus_moea/platypus_moea.spl \
--       --adapter claude_cli --param use_solver=true
--   spl3 run cookbook/121_platypus_moea/platypus_moea.spl \
--       --adapter claude_cli --param use_solver=false
-- ============================================================

-- ── TOOL_API wrappers ─────────────────────────────────────────

CREATE TOOL_API solve_workforce_platypus(problem_json TEXT, n_eval TEXT, pop_size TEXT)
RETURNS TEXT AS PYTHON $$
def solve_workforce_platypus(problem_json: str, n_eval: str, pop_size: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "121_platypus_moea")
    if _dir not in sys.path:
        sys.path.insert(0, _dir)
    from tools import solve_workforce_platypus as _fn
    return _fn(problem_json, n_eval=n_eval, pop_size=pop_size)
$$;

