-- summarize_arxiv_paper.spl
-- Sub-workflow: given ONE arXiv paper URL, look up its ground-truth metadata,
-- download the PDF, chunk it by section, summarize each section (map), then
-- reduce to one structured per-paper digest. Returns a JSON object string —
-- one "card" for the frontend.
--
-- Called by arxiv_digest.spl once per paper in the attendee's submitted list.
--
-- Debug logging (@out_dir / @run_dir — see readme.md "Debugging" section):
--   RUN_DIR   = <out_dir>/run-<timestamp>/         one per arxiv_digest batch
--                                                   (or per standalone unit-test run)
--   ARXIV_DIR = RUN_DIR/<arxiv-id>/                one per paper
--     ARXIV_DIR/pdf/<name>.pdf                     the exact PDF chunking ran on
--     ARXIV_DIR/chunk/NN_<slug>.md                 one file per section chunk
--     ARXIV_DIR/section_summary_raw.md              MAP step output (named
--                                                    "_raw" so the final
--                                                    digest-<id>.json — the
--                                                    REDUCE step's actual
--                                                    output — is what a
--                                                    reader's eye lands on)
--     ARXIV_DIR/digest-<arxiv-id>.json             REDUCE step output + final
--                                                   assembled card (one file —
--                                                   the card's "digest" field
--                                                   already carries the text)
-- When called from arxiv_digest.spl, RUN_DIR is already resolved once for
-- the whole batch and passed in via @run_dir (so @out_dir here stays '').
-- Run standalone, @out_dir triggers this workflow to create its own RUN_DIR.

IMPORT 'functions.spl'
IMPORT 'tools'

WORKFLOW summarize_arxiv_paper
    -- Note: functions.spl's prompts target these values as WORDS, but WITH
    -- OUTPUT BUDGET below enforces them as hard TOKEN caps — English runs
    -- ~0.75 words/token, so these carry ~35% headroom over the literal word
    -- target to avoid mid-sentence truncation (observed 2026-08-19 at the
    -- old 120/400 defaults on a 9-section paper).
    INPUT:  @url            TEXT,
            @section_tokens INT DEFAULT 180,
            @digest_tokens  INT DEFAULT 700,
            @pdf_max_chars  INT DEFAULT 200000,
            @out_dir        TEXT DEFAULT '',
            @run_dir        TEXT DEFAULT ''
    OUTPUT: @paper_digest_json TEXT
DO
    -- Per-paper timing (distinct from the whole-batch elapsed_sec api/app.py's
    -- digest() records) — see now_seconds/elapsed_seconds in tools.spl.
    CALL now_seconds() INTO @start_ts

    -- Resolve RUN_DIR: use the caller-supplied one (arxiv_digest.spl already
    -- made it for the whole batch), or make our own when run standalone.
    EVALUATE @run_dir
        WHEN = '' THEN
            EVALUATE @out_dir
                WHEN != '' THEN
                    CALL make_run_dir(@out_dir) INTO @run_dir
            END
    END

    -- Step A: ground-truth metadata (title/authors), not a guess from PDF headers
    CALL extract_arxiv_id(@url) INTO @arxiv_id
    CALL lookup_arxiv(@arxiv_id) INTO @meta_json
    CALL json_field(@meta_json, 'title')    INTO @title
    CALL json_field(@meta_json, 'authors')  INTO @authors
    CALL json_field(@meta_json, 'pdf_url')  INTO @pdf_url
    -- Verbatim, not LLM-summarized — see assemble_paper_digest's comment and
    -- semantic_chunk_plan's Abstract-section exclusion in tools.spl.
    CALL json_field(@meta_json, 'summary')  INTO @abstract

    -- ARXIV_DIR = RUN_DIR/<arxiv-id>/ — only meaningful once RUN_DIR is known
    @arxiv_dir := ''
    EVALUATE @run_dir
        WHEN != '' THEN
            @arxiv_dir := f'{@run_dir}/{@arxiv_id}'
            LOGGING f'[{@arxiv_id}] debug artifacts -> {@arxiv_dir}'
    END

    LOGGING f'[{@arxiv_id}] "{@title}" — downloading and chunking'

    -- Step B: download PDF (cached, rate-limited) and split into sections
    CALL download_arxiv_pdf(@pdf_url) INTO @pdf_path

    -- Debug dump: the exact PDF bytes semantic_chunk_plan is about to read,
    -- copied out of the shared download cache into ARXIV_DIR/pdf/.
    EVALUATE @arxiv_dir
        WHEN != '' THEN
            CALL save_pdf_copy(@pdf_path, @arxiv_dir) INTO @pdf_debug_path
    END

    CALL semantic_chunk_plan(@pdf_path, @pdf_max_chars) INTO @chunks_json
    CALL list_count(@chunks_json) INTO @section_count

    LOGGING f'[{@arxiv_id}] {@section_count} sections'

    -- Debug dump: one file per section chunk in ARXIV_DIR/chunk/ — this is
    -- the critical one for verifying the semantic chunking logic, since it
    -- shows exactly how the PDF text got split before any summarization.
    EVALUATE @arxiv_dir
        WHEN != '' THEN
            CALL save_chunks(@chunks_json, @arxiv_dir) INTO @chunk_debug_dir
    END

    -- Step C: MAP — summarize each section independently
    @section_summaries := ''
    @j := 0
    WHILE @j < @section_count DO
        CALL get_chunk_field(@chunks_json, @j, 'title') INTO @sec_title
        CALL get_chunk_field(@chunks_json, @j, 'text')  INTO @sec_text

        GENERATE section_summarizer(@sec_title, @sec_text, @section_tokens)
            WITH OUTPUT BUDGET @section_tokens TOKENS
            INTO @sec_summary

        @section_summaries := @section_summaries + f'### {@sec_title}\n{@sec_summary}\n\n'
        @j := @j + 1
    END

    -- Step D: REDUCE — one structured digest for the whole paper
    GENERATE paper_digest_writer(@title, @section_summaries, @digest_tokens)
        WITH OUTPUT BUDGET @digest_tokens TOKENS
        INTO @digest

    CALL elapsed_seconds(@start_ts) INTO @paper_elapsed_sec

    -- Step E: package as one JSON object — the frontend's per-paper card
    CALL assemble_paper_digest(@arxiv_id, @title, @authors, @url, @section_count, @digest, @abstract, @paper_elapsed_sec)
        INTO @paper_digest_json

    -- Debug dump: the map-step summaries, the final assembled card (its own
    -- "digest" field already carries the reduce-step digest text, so one
    -- file covers both rather than duplicating it into a separate .md), and
    -- this paper's own meta.json — picked up automatically by api/app.py's
    -- _scan_dir (it reads meta.json from ANY directory, not just RUN_DIR),
    -- so this paper's row in the Past Runs tree shows its own elapsed time
    -- inline, same as a whole run's row does.
    EVALUATE @arxiv_dir
        WHEN != '' THEN
            CALL write_file(f'{@arxiv_dir}/section_summary_raw.md', @section_summaries) INTO NONE
            CALL write_file(f'{@arxiv_dir}/digest-{@arxiv_id}.json', @paper_digest_json) INTO NONE
            CALL write_file(f'{@arxiv_dir}/meta.json', f'{{"elapsed_sec": {@paper_elapsed_sec}}}') INTO NONE
    END

    LOGGING f'[{@arxiv_id}] digest complete in {@paper_elapsed_sec}s'
    RETURN @paper_digest_json

EXCEPTION
    WHEN ToolError THEN
        LOGGING f'[{@url}] download/lookup failed — skipping'
        CALL elapsed_seconds(@start_ts) INTO @paper_elapsed_sec
        CALL assemble_paper_digest(@url, 'Unavailable', '', @url, 0, 'Could not retrieve or process this paper.', '', @paper_elapsed_sec)
            INTO @paper_digest_json
        RETURN @paper_digest_json
    WHEN OTHERS THEN
        LOGGING f'[{@url}] unexpected error — skipping'
        CALL elapsed_seconds(@start_ts) INTO @paper_elapsed_sec
        CALL assemble_paper_digest(@url, 'Unavailable', '', @url, 0, 'An unexpected error occurred processing this paper.', '', @paper_elapsed_sec)
            INTO @paper_digest_json
        RETURN @paper_digest_json
END
