-- tools.spl — TOOL_API definitions for Recipe 89: arXiv Digest (EAAI-27 workshop)
-- Imported by arxiv_digest.spl and summarize_arxiv_paper.spl via IMPORT 'tools'
--
-- Reused as-is from earlier recipes (attributed per function):
--   download_arxiv_pdf, semantic_chunk_plan, list_count, parse_urls
--     — cookbook/47_arxiv_morning_brief/tools.spl
--   extract_arxiv_id, lookup_arxiv, json_field
--     — cookbook/72_verify_arxiv_references/verify_arxiv_references.spl
-- New for this recipe: get_chunk_field, append_json_array,
--   make_run_dir, save_pdf_copy, save_chunks (debug/out_dir logging)
--
-- Stdlib tools used by this recipe (no TOOL_API needed): list_get, list_append,
--   write_file

CREATE TOOL_API download_arxiv_pdf(url TEXT)
RETURNS TEXT AS PYTHON $$
def download_arxiv_pdf(url: str) -> str:
    """Delegate to the FastAPI /api/pdf download service.

    The service handles caching, concurrent-request deduplication, arXiv rate
    limiting, and request_count tracking in the pdf_cache DB table.  This tool
    just calls it and returns the local file path."""
    import os
    import httpx

    api_url = os.environ.get("AD_API_URL", "http://localhost:8300")
    resp = httpx.post(f"{api_url}/api/pdf", json={"url": url}, timeout=120.0)
    resp.raise_for_status()
    return resp.json()["file_path"]
$$;

CREATE TOOL_API semantic_chunk_plan(pdf_path TEXT, max_chars TEXT)
RETURNS TEXT AS PYTHON $$
def semantic_chunk_plan(pdf_path: str, max_chars: str) -> str:
    import json
    import re
    from pathlib import Path

    path = Path(pdf_path)
    if not path.exists():
        raise RuntimeError(f"PDF not found: {pdf_path}")

    # Default 200_000 chars — raised from the 40_000 originally inherited from
    # cookbook/47_arxiv_morning_brief/tools.spl, which silently truncated
    # mid-paper and dropped trailing sections entirely (confirmed 2026-08-19: a
    # 54,945-char paper had its Conclusion section, starting at offset 48,484,
    # cut off before the header regex below ever saw it). Now caller-tunable —
    # see arxiv_digest.spl's @pdf_max_chars / the frontend Settings page — since
    # this doesn't change per-call LLM cost (each matched header still becomes
    # its own independently-summarized chunk), only how much of the paper the
    # chunker gets to see in the first place.
    try:
        effective_max_chars = int(float(max_chars)) if str(max_chars).strip() else 200_000
    except (TypeError, ValueError):
        effective_max_chars = 200_000

    try:
        from dd_extract.pdf import PDFExtractor
        extractor = PDFExtractor(engine="pypdf", max_chars=effective_max_chars)
        text = extractor.from_file(pdf_path)
    except Exception as e:
        raise RuntimeError(f"dd-extract failed on {pdf_path}: {e}") from e

    # PostgreSQL (Momagrid hub) rejects null bytes in text columns.
    text = text.replace('\x00', '')

    if not text.strip():
        raise RuntimeError(f"No text extracted from {pdf_path}")

    header_re = re.compile(
        r'^(?:\d+\.?\s+[A-Z][A-Za-z\s]{2,60}|[A-Z][A-Z\s]{4,60})$',
        re.MULTILINE,
    )
    matches = list(header_re.finditer(text))

    chunks = []

    if len(matches) >= 2:
        for i, m in enumerate(matches):
            end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
            chunk_text = text[m.start():end].strip()
            if chunk_text:
                chunks.append({
                    "title": m.group().strip(),
                    "text":  chunk_text,
                    "page":  i + 1,
                })
    else:
        paragraphs = [p.strip() for p in re.split(r'\n\s*\n', text) if p.strip()]
        group_size = 3
        for idx in range(0, len(paragraphs), group_size):
            group = paragraphs[idx: idx + group_size]
            chunks.append({
                "title": f"Section {idx // group_size + 1}",
                "text":  "\n\n".join(group),
                "page":  idx // group_size + 1,
            })

    # Drop References/Bibliography, Appendix/Appendices, and Abstract
    # sections — the first two are citation lists / supplementary material,
    # not core paper content worth a section_summarizer call; Abstract is
    # dropped for the opposite reason — it's already fetched verbatim as
    # ground truth via lookup_arxiv (see summarize_arxiv_paper.spl's @abstract
    # / assemble_paper_digest), so re-chunking and re-summarizing it here
    # would be redundant and risks a paraphrased duplicate showing up
    # alongside the real one. Only applied when it leaves at least one chunk
    # behind, so a false-positive title match (e.g. a paragraph-grouped
    # "Section N" chunk that happens to start with one of these words) can't
    # silently empty the whole paper.
    EXCLUDE_TITLE_RE = re.compile(
        r'^(?:\d+\.?\s+)?(references?|bibliography|append(?:ix(?:es)?|ices)|abstract)\b',
        re.IGNORECASE,
    )
    filtered = [c for c in chunks if not EXCLUDE_TITLE_RE.match(c["title"].strip())]
    if filtered:
        chunks = filtered

    # Truncate at Conclusion (inclusive) — appendix sub-sections that follow it
    # (e.g. cookbook recipes, table rows) are not core paper body. Only applied
    # when a Conclusion chunk is found; papers without one keep everything.
    STOP_AFTER_RE = re.compile(
        r'^(?:\d+\.?\s+)?conclusions?\b',
        re.IGNORECASE,
    )
    stop_idx = next(
        (i for i, c in enumerate(chunks) if STOP_AFTER_RE.match(c["title"].strip())),
        None,
    )
    if stop_idx is not None:
        chunks = chunks[:stop_idx + 1]

    if not chunks:
        chunks = [{"title": "Document", "text": text.strip(), "page": 1}]

    # Split any oversized chunk instead of sending it as one giant prompt.
    # The header-detection regex above can miss an interior header in an
    # oddly-formatted PDF, letting one "section" swallow a huge fraction of
    # the paper — observed 2026-08-19 producing an 83k-char section_text
    # that blew past the Momagrid hub's MaxPromptChars guard (default
    # 50,000, see internal/hub/app.go in the momagrid repo) with an HTTP 413,
    # independent of which model was targeted. 30,000 leaves headroom under
    # that default for section_summarizer's own prompt instructions text.
    MAX_CHUNK_CHARS = 30_000
    split_chunks = []
    for c in chunks:
        chunk_text = c["text"]
        if len(chunk_text) <= MAX_CHUNK_CHARS:
            split_chunks.append(c)
            continue
        parts = [chunk_text[i:i + MAX_CHUNK_CHARS] for i in range(0, len(chunk_text), MAX_CHUNK_CHARS)]
        for i, part in enumerate(parts):
            split_chunks.append({
                "title": f'{c["title"]} (part {i + 1}/{len(parts)})',
                "text":  part,
                "page":  c["page"],
            })
    chunks = split_chunks

    return json.dumps(chunks)
$$;

CREATE TOOL_API get_chunk_field(chunks_json TEXT, idx TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def get_chunk_field(chunks_json: str, idx: str, field: str) -> str:
    """Pull one field ('title' or 'text') out of the idx-th (0-based) chunk
    object produced by semantic_chunk_plan. Returns "" if out of range."""
    import json

    try:
        chunks = json.loads(chunks_json)
        i = int(float(idx))
        return str(chunks[i].get(field, ""))
    except (json.JSONDecodeError, TypeError, IndexError, ValueError, AttributeError):
        return ""
$$;

CREATE TOOL_API list_count(json_list TEXT)
RETURNS TEXT AS PYTHON $$
def list_count(json_list: str) -> str:
    import json

    try:
        return str(len(json.loads(json_list)))
    except (json.JSONDecodeError, TypeError):
        return "0"
$$;

CREATE TOOL_API parse_urls(raw TEXT)
RETURNS TEXT AS PYTHON $$
def parse_urls(raw: str) -> str:
    """Normalise the attendee's submitted paper list — accepts a JSON array
    (what the web front's form POST will send — see SubmitForm.vue, which
    pre-splits on the same delimiter set client-side), or a raw string
    delimited by any mix of commas, semicolons, or whitespace (space, tab,
    newline), or a file path (for CLI testing) — into a JSON array of URLs.
    Each entry may be a full arxiv.org URL or a bare arXiv id
    ('2510.01230', optionally 'arXiv:2510.01230' or with a 'vN' suffix);
    bare ids are expanded to 'https://arxiv.org/abs/<id>' so downstream
    steps (extract_arxiv_id, lookup_arxiv, ...) only ever see URLs."""
    import json
    import re
    from pathlib import Path

    ARXIV_ID_RE = re.compile(r'^(?:arxiv\s*:\s*)?(\d{4}\.\d{4,5})(?:v\d+)?$', re.IGNORECASE)

    def _to_url(entry: str) -> str:
        entry = entry.strip()
        m = ARXIV_ID_RE.match(entry)
        if m:
            return f'https://arxiv.org/abs/{m.group(1)}'
        return entry

    raw = raw.strip()

    try:
        parsed = json.loads(raw)
        if isinstance(parsed, list):
            urls = [_to_url(str(u)) for u in parsed if str(u).strip()]
            return json.dumps(urls)
    except (json.JSONDecodeError, ValueError):
        pass

    if not raw.startswith("http") and not raw.startswith("["):
        candidate = Path.cwd() / raw
        if candidate.is_file():
            lines = candidate.read_text(encoding="utf-8").splitlines()
            urls = [
                _to_url(ln) for ln in lines
                if ln.strip() and not ln.strip().startswith("#")
            ]
            return json.dumps(urls)

    urls = [_to_url(u) for u in re.split(r"[,;\s]+", raw) if u.strip()]
    return json.dumps(urls)
$$;

CREATE TOOL_API now_seconds()
RETURNS TEXT AS PYTHON $$
def now_seconds() -> str:
    """Wall-clock epoch time as a string — paired with elapsed_seconds() to
    time one paper's processing (see summarize_arxiv_paper.spl's @start_ts /
    @paper_elapsed_sec) without relying on SPL-level numeric arithmetic on
    @vars, which this recipe doesn't otherwise use."""
    import time

    return str(time.time())
$$;

CREATE TOOL_API elapsed_seconds(start_ts TEXT)
RETURNS TEXT AS PYTHON $$
def elapsed_seconds(start_ts: str) -> str:
    """Seconds elapsed since start_ts (a now_seconds() return value), rounded
    to 1 decimal. Returns '0.0' if start_ts is missing/unparseable rather
    than raising — a timing field is never worth failing a paper over."""
    import time

    try:
        return str(round(time.time() - float(start_ts), 1))
    except (TypeError, ValueError):
        return "0.0"
$$;

CREATE TOOL_API make_run_dir(out_dir TEXT)
RETURNS TEXT AS PYTHON $$
def make_run_dir(out_dir: str) -> str:
    """Create '<out_dir>/run-<timestamp>/' and return its path — one shared
    directory for every paper in a single arxiv_digest run (or a single
    summarize_arxiv_paper unit-test run). Returns '' unchanged if out_dir is
    empty, so debug dumping stays opt-in."""
    import datetime
    from pathlib import Path

    out_dir = out_dir.strip()
    if not out_dir:
        return ""

    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    run_dir = Path(out_dir) / f"run-{ts}"
    run_dir.mkdir(parents=True, exist_ok=True)
    return str(run_dir)
$$;

CREATE TOOL_API save_pdf_copy(pdf_path TEXT, arxiv_dir TEXT)
RETURNS TEXT AS PYTHON $$
def save_pdf_copy(pdf_path: str, arxiv_dir: str) -> str:
    """Create a symlink '<arxiv_dir>/pdf/<name>.pdf' → the shared PDF in
    ~/Documents/PDF/arxiv/ so the per-run debug tree shows the file without
    duplicating bytes on disk.  The symlink target is absolute so it resolves
    regardless of cwd.  Returns the symlink path, or '' if arxiv_dir is empty."""
    import os
    from pathlib import Path

    arxiv_dir = arxiv_dir.strip()
    if not arxiv_dir:
        return ""

    src  = Path(pdf_path).resolve()   # absolute path to shared PDF
    pdf_dir = Path(arxiv_dir) / "pdf"
    pdf_dir.mkdir(parents=True, exist_ok=True)
    link = pdf_dir / src.name
    if link.exists() or link.is_symlink():   # replace stale link or old copy
        link.unlink()
    os.symlink(src, link)
    return str(link)
$$;

CREATE TOOL_API save_chunks(chunks_json TEXT, arxiv_dir TEXT)
RETURNS TEXT AS PYTHON $$
def save_chunks(chunks_json: str, arxiv_dir: str) -> str:
    """Write each section chunk from semantic_chunk_plan's output into
    '<arxiv_dir>/chunk/NN_<slug>.md' — one file per section — so the
    chunking logic (what got split where, and on what text) can be checked
    directly rather than inferred from the final digest. Returns the chunk
    directory path, or '' if arxiv_dir is empty."""
    import json
    import re
    from pathlib import Path

    arxiv_dir = arxiv_dir.strip()
    if not arxiv_dir:
        return ""

    chunk_dir = Path(arxiv_dir) / "chunk"
    chunk_dir.mkdir(parents=True, exist_ok=True)

    try:
        chunks = json.loads(chunks_json)
    except (json.JSONDecodeError, TypeError):
        chunks = []

    for i, chunk in enumerate(chunks):
        title = str(chunk.get("title", "")).strip() or "untitled"
        slug = re.sub(r"[^a-z0-9]+", "_", title.lower()).strip("_")[:40] or "untitled"
        text = str(chunk.get("text", ""))
        (chunk_dir / f"{i:02d}_{slug}.md").write_text(f"# {title}\n\n{text}", encoding="utf-8")

    return str(chunk_dir)
$$;

CREATE TOOL_API extract_arxiv_id(ref_text TEXT)
RETURNS TEXT AS PYTHON $$
def extract_arxiv_id(ref_text: str) -> str:
    """Pull an arXiv id ('XXXX.XXXXX') from 'arXiv:...' text or an
    arxiv.org/abs|pdf URL. Returns "" if the text cites no arXiv id."""
    import re

    m = re.search(r'arxiv\s*:\s*(\d{4}\.\d{4,5})', ref_text, re.IGNORECASE)
    if m:
        return m.group(1)
    m = re.search(r'arxiv\.org/(?:abs|pdf)/(\d{4}\.\d{4,5})', ref_text, re.IGNORECASE)
    if m:
        return m.group(1)
    return ""
$$;

CREATE TOOL_API lookup_arxiv(arxiv_id TEXT)
RETURNS TEXT AS PYTHON $$
def lookup_arxiv(arxiv_id: str) -> str:
    """Look up the ground-truth record (title, authors, abstract, pdf url)
    for arxiv_id, in three falling-back tiers:

    1. The Atom API (export.arxiv.org) — richest metadata, but this host has
       been observed (2026-08-19) to hang mid-TLS-handshake on some
       networks, so it gets a short timeout and a fall-through on any
       failure rather than blocking the whole paper for tens of seconds.
    2. Scraping arxiv.org/abs/<id> directly — arxiv.org itself (as opposed
       to export.arxiv.org) has stayed reliable even when the API host
       hangs; its citation_* <meta> tags carry the same title/authors/
       pdf-url data as the Atom API, just as HTML instead of Atom XML.
    3. A deterministic https://arxiv.org/pdf/<id> URL with no metadata, so
       the caller (summarize_arxiv_paper.spl) still downloads and chunks
       the actual paper even when both lookups above fail — only the
       title/authors are missing, not the paper's content.
    """
    import html as _html
    import json
    import re
    import xml.etree.ElementTree as ET

    import httpx

    fallback_pdf_url = f'https://arxiv.org/pdf/{arxiv_id}'

    def _clean(s):
        return re.sub(r'\s+', ' ', _html.unescape(s or "")).strip()

    # Tier 1: Atom API
    try:
        api_url = f'http://export.arxiv.org/api/query?id_list={arxiv_id}'
        resp = httpx.get(api_url, timeout=8.0, follow_redirects=True)
        if resp.status_code == 200:
            ns = {'atom': 'http://www.w3.org/2005/Atom'}
            root = ET.fromstring(resp.text)
            entry = root.find('atom:entry', ns)
            if entry is not None:
                title = _clean(entry.findtext('atom:title', default="", namespaces=ns))
                if title:
                    summary = _clean(entry.findtext('atom:summary', default="", namespaces=ns))
                    authors = [
                        _clean(a.findtext('atom:name', default="", namespaces=ns))
                        for a in entry.findall('atom:author', ns)
                    ]
                    authors = [a for a in authors if a]
                    pdf_url = ""
                    for link in entry.findall('atom:link', ns):
                        if link.get('title') == 'pdf' or link.get('type') == 'application/pdf':
                            pdf_url = link.get('href', "")
                            break
                    return json.dumps({
                        'arxiv_id': arxiv_id,
                        'title':    title,
                        'authors':  '; '.join(authors),
                        'summary':  summary,
                        'pdf_url':  pdf_url or fallback_pdf_url,
                    })
    except Exception:
        pass  # fall through to the HTML scrape below

    # Tier 2: scrape the abs page's citation_* meta tags
    try:
        abs_url = f'https://arxiv.org/abs/{arxiv_id}'
        resp = httpx.get(abs_url, timeout=15.0, follow_redirects=True)
        if resp.status_code == 200:
            page = resp.text
            m = re.search(r'<meta name="citation_title" content="([^"]*)"', page)
            title = _clean(m.group(1)) if m else ""
            if title:
                authors = [
                    _clean(a) for a in
                    re.findall(r'<meta name="citation_author" content="([^"]*)"', page)
                ]
                m = re.search(r'<meta name="citation_abstract" content="([^"]*)"', page)
                summary = _clean(m.group(1)) if m else ""
                m = re.search(r'<meta name="citation_pdf_url" content="([^"]*)"', page)
                pdf_url = m.group(1) if m else fallback_pdf_url
                return json.dumps({
                    'arxiv_id': arxiv_id,
                    'title':    title,
                    'authors':  '; '.join(authors),
                    'summary':  summary,
                    'pdf_url':  pdf_url,
                })
    except Exception:
        pass  # fall through to the PDF-only fallback below

    # Tier 3: no metadata source worked — still let the paper get processed
    return json.dumps({
        'arxiv_id': arxiv_id,
        'title':    'Unknown',
        'authors':  '',
        'summary':  '',
        'pdf_url':  fallback_pdf_url,
    })
$$;

CREATE TOOL_API json_field(json_str TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def json_field(json_str: str, field: str) -> str:
    import json

    try:
        obj = json.loads(json_str)
        return str(obj.get(field, ""))
    except (json.JSONDecodeError, TypeError, AttributeError):
        return ""
$$;

CREATE TOOL_API append_json_array(array_json TEXT, item_json TEXT)
RETURNS TEXT AS PYTHON $$
def append_json_array(array_json: str, item_json: str) -> str:
    """Deterministic accumulator: parse array_json (or start a new array if
    empty/invalid), append item_json (parsed as one object), return the
    updated JSON array as text. Keeps per-paper digest assembly explicit and
    safe rather than relying on SPL's native LIST serialization into a
    TOOL_API's TEXT parameter."""
    import json

    try:
        arr = json.loads(array_json) if array_json.strip() else []
        if not isinstance(arr, list):
            arr = []
    except (json.JSONDecodeError, TypeError):
        arr = []

    try:
        arr.append(json.loads(item_json))
    except (json.JSONDecodeError, TypeError):
        pass  # skip a malformed item rather than corrupt the whole array

    return json.dumps(arr)
$$;

CREATE TOOL_API parallel_map_summarize(chunks_json TEXT, model TEXT, section_tokens TEXT, hub_url TEXT, timeout_s TEXT, db_path TEXT, paper_id TEXT, chunk_timeout_s TEXT, max_retries TEXT)
RETURNS TEXT AS PYTHON $$
async def parallel_map_summarize(chunks_json: str, model: str, section_tokens: str, hub_url: str = "", timeout_s: str = "300", db_path: str = "", paper_id: str = "", chunk_timeout_s: str = "60", max_retries: str = "3") -> str:
    """Fan out ALL section summarizations to the momagrid hub simultaneously with
    per-chunk timeout and retry — handles GPU nodes going offline mid-task.

    Phase 1 — fan-out: all N chunks are submitted concurrently.
    Phase 2 — poll+retry: each chunk is polled independently.  If a chunk times
    out (chunk_timeout_s) its task is resubmitted with a fresh task_id (up to
    max_retries times); the DB row tracks job_id, retry_count, and final status
    so callers can see which node handled each chunk and whether any were retried.

    Returns the same '### Title\\nSummary\\n\\n' string that the sequential WHILE
    loop in summarize_arxiv_paper.spl produced, so the REDUCE step is unchanged.

    -- Keep the system prompt below in sync with section_summarizer in functions.spl --
    """
    import asyncio
    import datetime
    import json
    import logging
    import os
    import sqlite3
    import uuid
    from pathlib import Path

    import httpx

    _log = logging.getLogger("arxiv_digest.parallel_map")

    chunks = json.loads(chunks_json)
    max_tokens = int(float(section_tokens)) if str(section_tokens).strip() else 180
    global_timeout = float(timeout_s) if str(timeout_s).strip() else 300.0
    chunk_timeout = float(chunk_timeout_s) if str(chunk_timeout_s).strip() else 60.0
    n_retries = int(float(max_retries)) if str(max_retries).strip() else 3
    _db = db_path.strip()
    _pid = paper_id.strip()

    # Hub URL: param → env var → ~/.igrid/config.yaml (same priority as momagrid adapter)
    _hub = (hub_url or "").strip().rstrip("/")
    if not _hub:
        _hub = os.environ.get("MOMAGRID_HUB_URL", "").rstrip("/")
    if not _hub:
        config_path = Path.home() / ".igrid" / "config.yaml"
        try:
            in_hub = in_urls = False
            for line in config_path.read_text().splitlines():
                s, indent = line.lstrip(), len(line) - len(line.lstrip())
                if indent == 0:
                    in_hub = s.startswith("hub:")
                    in_urls = False
                    continue
                if in_hub and s.startswith("urls:"):
                    in_urls = True
                    continue
                if in_hub and in_urls and s.startswith("- "):
                    _hub = s[2:].strip().rstrip("/")
                    break
        except OSError:
            pass
    if not _hub:
        _hub = "http://localhost:9000"

    # Must match section_summarizer in functions.spl
    system_prompt = (
        f"You are a technical summarizer. Produce a concise summary of the following "
        f"research paper section in plain English. Focus on methods and findings. "
        f"Stay well under {max_tokens} words — leave headroom, since generation is cut "
        f"off at a hard token limit and an unfinished sentence is worse than a shorter "
        f"complete one. Write 2-4 complete sentences and stop; do not pad toward the "
        f"limit. Write plain prose only — no headings, no bullet points, no preamble "
        'such as "This section...".'
    )

    def _now() -> str:
        return datetime.datetime.now(datetime.timezone.utc).isoformat()

    def _db_connect():
        if not _db:
            return None
        con = sqlite3.connect(_db, timeout=10)
        con.execute("PRAGMA journal_mode=WAL")
        return con

    def _init_chunk_rows() -> dict:
        """Insert a PENDING row per chunk before fan-out; returns {chunk_idx: chunk_id}."""
        if not _db or not _pid:
            return {}
        chunk_id_map = {i: str(uuid.uuid4()) for i in range(len(chunks))}
        now = _now()
        con = _db_connect()
        con.execute("""CREATE TABLE IF NOT EXISTS chunks (
            chunk_id TEXT PRIMARY KEY, paper_id TEXT NOT NULL, chunk_idx INTEGER NOT NULL,
            title TEXT, text TEXT, summary TEXT,
            status TEXT NOT NULL DEFAULT 'PENDING',
            job_id TEXT, agent_name TEXT, retry_count INTEGER NOT NULL DEFAULT 0,
            last_error TEXT, submitted_at TEXT, completed_at TEXT, elapsed_sec REAL
        )""")
        for i, c in enumerate(chunks):
            con.execute(
                "INSERT INTO chunks "
                "(chunk_id,paper_id,chunk_idx,title,text,status,submitted_at) "
                "VALUES (?,?,?,?,?,'PENDING',?)",
                (chunk_id_map[i], _pid, i, c.get("title", ""), c.get("text", ""), now),
            )
        con.commit()
        con.close()
        return chunk_id_map

    def _db_chunk_update(chunk_id: str, **kwargs) -> None:
        if not _db or not chunk_id:
            return
        fields = [f"{k}=?" for k in kwargs]
        values = list(kwargs.values()) + [chunk_id]
        con = _db_connect()
        try:
            con.execute(f"UPDATE chunks SET {', '.join(fields)} WHERE chunk_id=?", values)
            con.commit()
        finally:
            con.close()

    chunk_id_map = _init_chunk_rows()

    async def _submit_one(client: httpx.AsyncClient, idx: int, chunk: dict) -> str:
        task_id = str(uuid.uuid4())
        payload = {
            "task_id": task_id,
            "model": model,
            "prompt": f"Section: {chunk['title']}\n\n{chunk['text']}",
            "system": system_prompt,
            "max_tokens": max_tokens,
            "temperature": 0.7,
            "timeout_s": int(global_timeout),
            "priority": 1,
        }
        resp = await client.post(f"{_hub}/tasks", json=payload)
        resp.raise_for_status()
        return resp.json().get("task_id", task_id)

    async def _poll_until_done(client: httpx.AsyncClient, task_id: str) -> dict:
        url = f"{_hub}/tasks/{task_id}"
        while True:
            resp = await client.get(url)
            resp.raise_for_status()
            data = resp.json()
            state = data.get("state", "")
            result = data.get("result", data)
            if state == "COMPLETE":
                return {"ok": True, "content": result.get("content", ""), "agent_name": result.get("agent_name", "")}
            if state == "FAILED":
                return {"ok": False, "error": result.get("error", "task failed")}
            await asyncio.sleep(2.0)

    async def _process_chunk(client: httpx.AsyncClient, idx: int, chunk: dict) -> tuple:
        title = chunk["title"]
        chunk_id = chunk_id_map.get(idx, "")
        for attempt in range(n_retries + 1):
            try:
                task_id = await _submit_one(client, idx, chunk)
                _log.info("MAP chunk %d attempt %d → task %s", idx, attempt, task_id[:8])
                _db_chunk_update(chunk_id, status="IN_FLIGHT", job_id=task_id, retry_count=attempt)

                result = await asyncio.wait_for(_poll_until_done(client, task_id), timeout=chunk_timeout)
                if result["ok"]:
                    content = result["content"]
                    _db_chunk_update(chunk_id, status="COMPLETE", summary=content,
                                     agent_name=result.get("agent_name", ""), completed_at=_now())
                    _log.info("MAP chunk %d complete (attempt %d)", idx, attempt)
                    return idx, title, content
                else:
                    error = result.get("error", "task failed")
                    _log.warning("MAP chunk %d FAILED on attempt %d: %s", idx, attempt, error)
                    if attempt < n_retries:
                        continue
                    _db_chunk_update(chunk_id, status="FAILED", last_error=error)
                    return idx, title, f"[Summary unavailable: {error}]"

            except asyncio.TimeoutError:
                _log.warning("MAP chunk %d timed out on attempt %d (%.0fs)", idx, attempt, chunk_timeout)
                if attempt < n_retries:
                    _db_chunk_update(chunk_id, retry_count=attempt + 1, last_error="timeout — retrying")
                    continue
                _db_chunk_update(chunk_id, status="FAILED", last_error="timeout after max retries")
                return idx, title, "[Summary unavailable: max retries exceeded]"

            except Exception as exc:
                _log.error("MAP chunk %d unexpected error on attempt %d: %s", idx, attempt, exc)
                if attempt < n_retries:
                    continue
                _db_chunk_update(chunk_id, status="FAILED", last_error=str(exc))
                return idx, title, f"[Summary unavailable: {exc}]"

        return idx, title, "[Summary unavailable]"

    async with httpx.AsyncClient(timeout=global_timeout + 30) as client:
        _log.info("Parallel MAP: %d chunks → %s model=%s (chunk_timeout=%.0fs retries=%d)",
                  len(chunks), _hub, model, chunk_timeout, n_retries)
        results = await asyncio.gather(*[_process_chunk(client, i, c) for i, c in enumerate(chunks)])
    ordered = sorted(results, key=lambda r: r[0])

    section_summaries = ""
    for _, title, summary in ordered:
        section_summaries += f"### {title}\n{summary}\n\n"
    return section_summaries
$$;

CREATE TOOL_API assemble_paper_digest(arxiv_id TEXT, title TEXT, authors TEXT, url TEXT, section_count TEXT, digest TEXT, abstract TEXT, elapsed_sec TEXT)
RETURNS TEXT AS PYTHON $$
def assemble_paper_digest(arxiv_id: str, title: str, authors: str, url: str, section_count: str, digest: str, abstract: str = "", elapsed_sec: str = "") -> str:
    """Package one paper's result as a JSON object string — the shape a
    FastAPI backend hands straight to the Vue frontend as one card.
    'abstract' is the paper's own abstract text verbatim (from lookup_arxiv's
    ground-truth metadata, NOT an LLM summary — see semantic_chunk_plan's
    Abstract-section exclusion in tools.spl), displayed as-is by the
    frontend rather than run through paper_digest_writer. 'elapsed_sec' is
    this one paper's own processing time (see now_seconds/elapsed_seconds
    and @start_ts in summarize_arxiv_paper.spl) — distinct from the
    whole-batch elapsed_sec api/app.py's digest() records in the run's own
    meta.json."""
    import json

    try:
        n = int(float(section_count))
    except (TypeError, ValueError):
        n = 0

    try:
        elapsed = round(float(elapsed_sec), 1)
    except (TypeError, ValueError):
        elapsed = None

    return json.dumps({
        "arxiv_id":      arxiv_id,
        "title":         title,
        "authors":       authors,
        "url":           url,
        "section_count": n,
        "abstract":      abstract,
        "digest":        digest,
        "elapsed_sec":   elapsed,
    })
$$;

CREATE TOOL_API init_paper_record(db_path TEXT, run_id TEXT, url TEXT, arxiv_id TEXT, title TEXT, authors TEXT, abstract TEXT, section_count TEXT)
RETURNS TEXT AS PYTHON $$
def init_paper_record(db_path: str, run_id: str, url: str, arxiv_id: str, title: str, authors: str, abstract: str, section_count: str) -> str:
    """Insert a PENDING papers row for this paper and return its paper_id UUID.
    Returns a throwaway UUID (not persisted) when db_path is empty so callers
    can always bind @paper_id without branching on DB availability."""
    import datetime
    import sqlite3
    import uuid

    paper_id = str(uuid.uuid4())
    _db = db_path.strip()
    if not _db:
        return paper_id

    now = datetime.datetime.now(datetime.timezone.utc).isoformat()
    try:
        n = int(float(section_count))
    except (TypeError, ValueError):
        n = 0

    con = sqlite3.connect(_db, timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("""CREATE TABLE IF NOT EXISTS papers (
        paper_id TEXT PRIMARY KEY, run_id TEXT NOT NULL, url TEXT NOT NULL,
        arxiv_id TEXT, title TEXT, authors TEXT, abstract TEXT,
        status TEXT NOT NULL DEFAULT 'PENDING', section_count INTEGER,
        submitted_at TEXT NOT NULL, completed_at TEXT, elapsed_sec REAL
    )""")
    con.execute(
        "INSERT INTO papers "
        "(paper_id,run_id,url,arxiv_id,title,authors,abstract,section_count,submitted_at) "
        "VALUES (?,?,?,?,?,?,?,?,?)",
        (paper_id, run_id, url, arxiv_id, title, authors, abstract, n, now),
    )
    con.commit()
    con.close()
    return paper_id
$$;

CREATE TOOL_API save_digest(db_path TEXT, paper_id TEXT, digest TEXT)
RETURNS TEXT AS PYTHON $$
def save_digest(db_path: str, paper_id: str, digest: str) -> str:
    """Upsert digest text into digests table and mark the paper COMPLETE.
    No-op when db_path is empty.  Returns '' always (callers use INTO NONE)."""
    import datetime
    import sqlite3

    _db = db_path.strip()
    if not _db or not paper_id.strip():
        return ""

    now = datetime.datetime.now(datetime.timezone.utc).isoformat()
    con = sqlite3.connect(_db, timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("""CREATE TABLE IF NOT EXISTS digests (
        paper_id TEXT PRIMARY KEY, digest TEXT, created_at TEXT NOT NULL
    )""")
    con.execute(
        "INSERT OR REPLACE INTO digests (paper_id, digest, created_at) VALUES (?,?,?)",
        (paper_id, digest, now),
    )
    con.execute(
        "UPDATE papers SET status='COMPLETE', completed_at=? WHERE paper_id=?",
        (now, paper_id),
    )
    con.commit()
    con.close()
    return ""
$$;

CREATE TOOL_API batch_section_summaries(summaries TEXT, batch_size TEXT DEFAULT '8')
RETURNS TEXT AS PYTHON $$
def batch_section_summaries(summaries: str, batch_size: str = '8') -> str:
    """Split section summaries (### Title\\nText\\n\\n...) into batches of batch_size
    sections each. Returns a JSON array of strings — one per batch — so the caller
    (summarize_arxiv_paper.spl) can iterate with list_count / get_batch without any
    Python-side knowledge of the SPL workflow's variable state."""
    import re
    import json

    try:
        n = max(1, int(float(batch_size)) if str(batch_size).strip() else 8)
    except (TypeError, ValueError):
        n = 8

    # Split on section headers; each part starts with '### <title>'
    parts = re.split(r'(?=^### )', summaries, flags=re.MULTILINE)
    parts = [p.strip() for p in parts if p.strip()]

    if not parts:
        return json.dumps([summaries.strip()] if summaries.strip() else [''])

    batches = []
    for i in range(0, len(parts), n):
        batches.append('\n\n'.join(parts[i:i + n]))
    return json.dumps(batches)
$$;

CREATE TOOL_API get_batch(batches_json TEXT, index TEXT)
RETURNS TEXT AS PYTHON $$
def get_batch(batches_json: str, index: str) -> str:
    """Return the index-th batch (0-based) from the JSON array produced by
    batch_section_summaries. Returns '' if index is out of range."""
    import json

    try:
        batches = json.loads(batches_json)
        i = int(float(index))
        return str(batches[i]) if 0 <= i < len(batches) else ''
    except (json.JSONDecodeError, TypeError, ValueError, IndexError):
        return ''
$$;

CREATE TOOL_API cap_section_summaries(summaries TEXT, max_total_chars TEXT DEFAULT '18000')
RETURNS TEXT AS PYTHON $$
def cap_section_summaries(summaries: str, max_total_chars: str = '18000') -> str:
    """Truncate per-section summaries so their total length stays within
    max_total_chars before the REDUCE step.

    Momagrid workers sometimes generate far beyond their max_tokens budget,
    producing a concatenated summary that exceeds the REDUCE model's context
    window and causes it to emit degenerate output like "Okay".  This tool
    caps the damage client-side after MAP returns, distributing the budget
    evenly across sections and breaking each at the nearest sentence end."""
    import re

    max_chars = int(float(max_total_chars)) if str(max_total_chars).strip() else 18000

    if len(summaries) <= max_chars:
        return summaries

    # Split on section headers (### Title\n) — keep the header in the part.
    parts = re.split(r'(?=^### )', summaries, flags=re.MULTILINE)
    parts = [p for p in parts if p.strip()]

    if not parts:
        return summaries[:max_chars]

    per_section = max(200, max_chars // len(parts))

    result = []
    for part in parts:
        if len(part) <= per_section:
            result.append(part)
        else:
            truncated = part[:per_section]
            # Try to end at a sentence boundary so the summary stays readable.
            last_dot = max(truncated.rfind('. '), truncated.rfind('.\n'))
            if last_dot > per_section // 2:
                truncated = truncated[:last_dot + 1]
            result.append(truncated.rstrip() + '\n')

    return '\n'.join(result)
$$;
