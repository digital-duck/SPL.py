-- Recipe Name: arXiv Digest (EAAI-27 workshop capstone)
-- Given a list of arXiv paper URLs an attendee submits, produce one
-- structured digest per paper: sections summarized independently (map),
-- then reduced into a paragraph-per-section + 3-bullet contribution summary
-- (reduce) — the Map-Reduce pattern the EAAI-27 Model AI Assignment session
-- walks through live. Returns a JSON array, one object per paper, ready for
-- a thin frontend to render directly (no backend translation layer needed —
-- see docs/conference/EAAI-2027/submission/.../handout.md, "Capstone Demo").
--
-- Adapted from cookbook/47_arxiv_morning_brief (download/chunk/map/reduce
-- shape) and cookbook/72_verify_arxiv_references (ground-truth metadata
-- lookup, per-item error isolation) — see tools.spl for attribution.
--
-- Usage (tools.spl's TOOL_API defs load via IMPORT 'tools' — no --tools flag
-- needed; that flag is for external @spl_tool Python modules, a different
-- mechanism used by e.g. cookbook/13_map_reduce/tools.py). Params go through
-- spl3's -p/--param KEY=VALUE flag (spl3, unlike the older `spl` CLI, does
-- NOT accept bare positional key=value args):
--   spl3 run cookbook/89_arxiv_digest_eaai27/arxiv_digest.spl \
--       --adapter ollama --model gemma3 \
--       -p urls='["https://arxiv.org/abs/2501.12948","https://arxiv.org/abs/2501.09732"]'
--
--   spl3 run cookbook/89_arxiv_digest_eaai27/arxiv_digest.spl \
--       -p urls="cookbook/89_arxiv_digest_eaai27/arxiv-papers.txt"
--
-- Workshop-grid dispatch (the capstone demo path). The hub never runs SPL —
-- something has to actually drive this .spl workflow (parse, chunk, loop,
-- map-reduce) and submit each individual GENERATE call to the hub as a
-- single-prompt task. That's either a person running spl3 by hand (below),
-- or, for the web form, a thin backend process that shells out to the same
-- command on the attendee's behalf (see arxiv-digest-eaai27 repo's
-- api/app.py):
--   spl3 run cookbook/89_arxiv_digest_eaai27/arxiv_digest.spl \
--       --adapter momagrid --hub https://hub.WORKSHOP_DOMAIN \
--       -p urls='["https://arxiv.org/abs/2501.12948"]'
--
-- Note on parallelism: today's SPL (3.0) dispatches sub-workflow CALLs
-- sequentially within one script run (CALL PARALLEL fan-out is flagged for
-- a future SPL version — see cookbook/47_arxiv_morning_brief/readme.md).
-- The "several papers' worth of jobs in flight simultaneously" the EAAI-27
-- capstone demo describes comes from concurrent attendee submissions each
-- becoming their own script run against the shared hub, not from a single
-- run's internal loop running in parallel.

IMPORT 'summarize_arxiv_paper.spl'
IMPORT 'tools'

WORKFLOW arxiv_digest
    INPUT:
        @urls           TEXT,
        -- Note: functions.spl's prompts tell the model to target this many
        -- WORDS, but WITH OUTPUT BUDGET enforces it as a hard TOKEN cap —
        -- English runs ~0.75 words/token, so these carry ~35% headroom over
        -- the literal word target to avoid mid-sentence truncation (observed
        -- 2026-08-19 at the old 120/400 defaults on a 9-section paper).
        @section_tokens INT DEFAULT 180,
        @digest_tokens  INT DEFAULT 700,
        @pdf_max_chars  INT DEFAULT 200000,
        @out_dir        TEXT DEFAULT ''
    OUTPUT: @digest_json TEXT
DO
    LOGGING 'arXiv Digest — starting'

    -- Normalise the submitted list: JSON array (what the web form POSTs),
    -- comma/whitespace-delimited text, or a file path (CLI testing).
    CALL parse_urls(@urls) INTO @urls
    CALL list_count(@urls) INTO @n

    LOGGING f'Papers to process: {@n}'

    -- Resolve RUN_DIR = <out_dir>/run-<timestamp>/ ONCE for the whole batch,
    -- so every paper's ARXIV_DIR (in summarize_arxiv_paper.spl) lands under
    -- the same run. Passed down explicitly via @run_dir so each per-paper
    -- CALL doesn't re-timestamp its own nested run dir (@out_dir stays '').
    @run_dir := ''
    EVALUATE @out_dir
        WHEN != '' THEN
            CALL make_run_dir(@out_dir) INTO @run_dir
            LOGGING f'Run dir: {@run_dir}'
    END

    @results_json := '[]'
    @i := 0

    -- ── Per-paper loop ───────────────────────────────────────────────────
    WHILE @i < @n DO
        CALL list_get(@urls, @i + 1) INTO @url
        LOGGING f'Paper {@i}/{@n}: {@url}'
        CALL now_seconds() INTO @paper_start_ts

        DO
            CALL summarize_arxiv_paper(@url, @section_tokens, @digest_tokens, @pdf_max_chars, '', @run_dir)
                INTO @paper_digest_json
            CALL append_json_array(@results_json, @paper_digest_json)
                INTO @results_json
        EXCEPTION
            -- summarize_arxiv_paper.spl already catches its own ToolError/
            -- OTHERS internally and returns a fallback digest card (see its
            -- own EXCEPTION block) — this outer handler only fires for
            -- failures that escape THAT try (e.g. an adapter-level error
            -- during GENERATE, observed 2026-08-19 to propagate past the
            -- inner handler and abort just this one CALL). Without adding a
            -- fallback card here too, such a paper silently vanishes from
            -- @results_json instead of showing up as a visible error in the
            -- frontend — so mirror the same fallback shape here. Timed from
            -- @paper_start_ts above (not the inner workflow's own @start_ts,
            -- which is out of scope here) so even a crashed paper's card
            -- shows how long it ran before failing.
            WHEN ToolError THEN
                LOGGING f'Skipping {@url}: tool/download error'
                CALL elapsed_seconds(@paper_start_ts) INTO @paper_elapsed_sec
                CALL assemble_paper_digest(@url, 'Unavailable', '', @url, 0, 'Could not retrieve or process this paper.', '', @paper_elapsed_sec)
                    INTO @paper_digest_json
                CALL append_json_array(@results_json, @paper_digest_json)
                    INTO @results_json
            WHEN OTHERS THEN
                LOGGING f'Skipping {@url}: unexpected error'
                CALL elapsed_seconds(@paper_start_ts) INTO @paper_elapsed_sec
                CALL assemble_paper_digest(@url, 'Unavailable', '', @url, 0, 'An unexpected error occurred processing this paper.', '', @paper_elapsed_sec)
                    INTO @paper_digest_json
                CALL append_json_array(@results_json, @paper_digest_json)
                    INTO @results_json
        END

        @i := @i + 1
    END

    LOGGING f'All {@n} papers processed'

    -- Debug dump: the final aggregated array, at the top of RUN_DIR,
    -- alongside each paper's own ARXIV_DIR from summarize_arxiv_paper.
    EVALUATE @run_dir
        WHEN != '' THEN
            CALL write_file(f'{@run_dir}/results.json', @results_json) INTO NONE
    END

    RETURN @results_json WITH status = 'complete', papers = @n

EXCEPTION
    WHEN OTHERS THEN
        LOGGING 'arXiv digest failed'
        RETURN '[]' WITH status = 'error'
END
