-- ── LLM prompt templates ─────────────────────────────────────

CREATE FUNCTION interpret_portfolio(tickers TEXT, period TEXT, capital TEXT,
                                    target_return TEXT, max_weight TEXT,
                                    optimization_json TEXT, allocation_json TEXT)
RETURNS TEXT AS $$
Interpret this portfolio optimization result for a personal investor.

Stocks considered: {tickers}
Historical period: {period}
Capital to invest: ${capital}
Target annual return: {target_return} (decimal, e.g. 0.12 = 12%)
Max single position: {max_weight} (decimal, e.g. 0.40 = 40%)

Optimization result (JSON): {optimization_json}
Capital allocation (JSON): {allocation_json}

Your interpretation should:
1. Summarise the recommended portfolio (which stocks and their % weights)
2. State expected annual return, volatility, and Sharpe ratio in plain terms
3. Explain any stocks excluded or at very low weight
4. Give one rebalancing tip (e.g. review quarterly)
5. Add disclaimer: past performance does not guarantee future results

Be friendly and practical — this is for personal use, not a formal report.
$$;

CREATE FUNCTION suggest_allocation(tickers TEXT, market_data_json TEXT,
                                   capital TEXT, target_return TEXT, max_weight TEXT)
RETURNS TEXT AS $$
You are a personal finance advisor. Suggest a stock portfolio allocation.

Stocks to consider: {tickers}
Historical data (annual returns and covariance): {market_data_json}
Capital to invest: ${capital}
Target annual return: at least {target_return} (e.g. 0.12 = 12%)
Max per stock: {max_weight} (e.g. 0.40 = 40%)

Steps:
1. Review each stock's historical annual return and volatility.
2. Rank stocks by risk-adjusted return (return / volatility).
3. Propose percentage weights that sum to 100%, each <= {max_weight}.
4. Estimate the blended expected return and risk level (low/medium/high).
5. Show dollar amounts for ${capital} capital.

Be concrete. Show your reasoning.
$$;

CREATE FUNCTION extract_weights_json(allocation_text TEXT)
RETURNS TEXT AS $$
Extract the portfolio weights from this analysis into JSON.
Return ONLY a JSON object — no markdown, no prose:
{{
  "status": "OPTIMAL",
  "weights": {{"TICKER1": 0.30, "TICKER2": 0.25, ...}},
  "expected_return": 0.12,
  "annual_volatility": 0.18,
  "sharpe_ratio": 0.39
}}

All weights must be decimals (not percentages). They must sum to approximately 1.0.

Analysis: {allocation_text}
$$;

CREATE FUNCTION suggest_algorithm(tickers TEXT, market_data_json TEXT, target_return TEXT)
RETURNS TEXT AS $$
You are a quantitative portfolio analyst. Select the best optimization algorithm for this portfolio.

Tickers: {tickers}
Target annual return: {target_return}
Market data (returns + covariance): {market_data_json}

Available algorithms:
  markowitz   — Classic mean-variance QP. Best when history is long (>2yr) and N>=10.
  min_variance— Ignore return target, minimize risk only. Best when μ estimates are noisy.
  max_sharpe  — Maximize return per unit risk. Best for single optimal portfolio.
  risk_parity — Equal risk contribution. Best for multi-asset, defensive mandates.
  hrp         — Hierarchical Risk Parity. Best for small N (<10) or short history (<1yr).
  cvar        — Minimize tail loss. Best when downside protection matters most.

Consider: number of tickers, data period length, return spread across assets, correlation structure.
Return ONLY the algorithm name, exactly as listed above (e.g. "hrp").
$$;

CREATE FUNCTION compare_algorithms(tickers TEXT, market_data_json TEXT,
                                   result_markowitz TEXT, result_min_variance TEXT,
                                   result_max_sharpe TEXT, result_risk_parity TEXT,
                                   result_hrp TEXT, result_cvar TEXT)
RETURNS TEXT AS $$
You are a quantitative portfolio analyst. Compare these six optimization results for the same stock universe and recommend the best one for a personal investor.

Tickers: {tickers}
Market data: {market_data_json}

Results:
  Markowitz:    {result_markowitz}
  Min Variance: {result_min_variance}
  Max Sharpe:   {result_max_sharpe}
  Risk Parity:  {result_risk_parity}
  HRP:          {result_hrp}
  CVaR:         {result_cvar}

Your analysis should:
1. Show a comparison table: algorithm | return | volatility | sharpe | # positions
2. Identify which algorithm gives the best risk-adjusted return (Sharpe)
3. Identify which gives the most diversified allocation
4. Recommend ONE algorithm for this specific portfolio and explain why in 2-3 sentences
5. Note any algorithms that failed or produced degenerate results
6. Add disclaimer: past performance does not guarantee future results
$$;

CREATE FUNCTION suggest_relaxed_target(target_return TEXT, market_data_json TEXT)
RETURNS TEXT AS $$
The portfolio optimization was infeasible with target_return={target_return}.
Given these historical returns: {market_data_json}
Suggest an achievable target return.
Return ONLY a decimal number, e.g. 0.08
$$;

-- ── WORKFLOW ─────────────────────────────────────────────────

WORKFLOW portfolio_optimization
  INPUT @tickers TEXT := "AAPL,MSFT,GOOGL,AMZN,NVDA"
  INPUT @capital TEXT := "10000"
  INPUT @period TEXT := "1y"
  INPUT @target_return TEXT := "0.12"
  INPUT @max_weight TEXT := "0.20"
  INPUT @adapter TEXT := "claude_cli"
  INPUT @model TEXT := ""
  INPUT @log_dir TEXT := "./logs"
  INPUT @algorithm TEXT := "markowitz"
  INPUT @use_solver TEXT := "true"
  OUTPUT @report TEXT
DO
  @sharpe_str        := "";
  @verify_status     := "N/A";
  @optimization_json := "{}";
  @allocation_json   := "{}";
  @llm_calls         := 0;

  LOGGING f"[portfolio] start  use_solver={@use_solver}  tickers={@tickers}  period={@period}  capital={@capital}" LEVEL INFO

  -- Fetch market data (same for both solver arms)
  CALL fetch_stock_data(@tickers, @period) INTO @market_data_json;
  LOGGING f"[portfolio] market_data:\n{@market_data_json}" LEVEL DEBUG

  EVALUATE @use_solver
    WHEN = "true" THEN
      -- solver=ON: deterministic optimization — algorithm selected or auto-picked by LLM
      LOGGING f"[portfolio] solver=ON — algorithm={@algorithm}" LEVEL INFO

      -- If algorithm=auto, let the LLM pick the best one for this data
      EVALUATE @algorithm
        WHEN = "auto" THEN
          GENERATE suggest_algorithm(@tickers, @market_data_json, @target_return) INTO @algorithm;
          @llm_calls := @llm_calls + 1;
          LOGGING f"[portfolio] auto-selected algorithm: {@algorithm}" LEVEL INFO
        ELSE
          @algorithm := @algorithm;
      END;

      CALL optimize_by_algorithm(@market_data_json, @algorithm, @target_return, @max_weight) INTO @optimization_json;
      CALL json_get_field(@optimization_json, "status") INTO @opt_status;

      -- If infeasible, relax the return target once and retry
      EVALUATE @opt_status
        WHEN = "OPTIMAL" THEN
          @opt_status := "OPTIMAL";   -- proceed as-is

        ELSE
          GENERATE suggest_relaxed_target(@target_return, @market_data_json) INTO @relaxed_target;
          @llm_calls := @llm_calls + 1;
          CALL optimize_by_algorithm(@market_data_json, @algorithm, @relaxed_target, @max_weight) INTO @optimization_json;
          -- Gate: must be optimal after relaxation
          ASSERT is_optimized(@optimization_json);
      END;

      CALL allocate_capital(@optimization_json, @capital) INTO @allocation_json;

      GENERATE interpret_portfolio(@tickers, @period, @capital, @target_return,
                                   @max_weight, @optimization_json, @allocation_json)
               INTO @interpretation;
      @llm_calls := @llm_calls + 1;

      CALL json_get_field(@optimization_json, "sharpe_ratio") INTO @sharpe_str;

      CALL format_solver_report(@tickers, @period, @capital, @target_return, @max_weight,
                               @market_data_json, @optimization_json, @allocation_json,
                               @interpretation, @llm_calls) INTO @report;

    ELSE
      -- solver=OFF: LLM heuristic allocation with back-check
      LOGGING "[portfolio] solver=OFF — LLM heuristic allocation" LEVEL INFO

      GENERATE suggest_allocation(@tickers, @market_data_json,
                                  @capital, @target_return, @max_weight)
               INTO @llm_allocation;
      @llm_calls := @llm_calls + 1;

      LOGGING f"[portfolio] llm_decomposition_output:\n{@llm_allocation}" LEVEL DEBUG

      GENERATE extract_weights_json(@llm_allocation) INTO @optimization_json;
      @llm_calls := @llm_calls + 1;

      CALL allocate_capital(@optimization_json, @capital) INTO @allocation_json;
      CALL verify_portfolio(@optimization_json) INTO @verify_result;

      CALL json_get_field(@verify_result, "verdict") INTO @verify_status;
      CALL json_get_field(@optimization_json, "sharpe_ratio") INTO @sharpe_str;

      LOGGING f"[portfolio] verify_off: verdict={@verify_status}  result={@verify_result}" LEVEL INFO

      CALL format_heuristic_report(@tickers, @period, @capital, @market_data_json,
                                  @llm_allocation, @optimization_json, @allocation_json,
                                  @verify_result, @llm_calls) INTO @report;

  END;

  LOGGING f"[portfolio] sharpe_ratio={@sharpe_str}  verify={@verify_status}" LEVEL INFO

  RETURN @report
    WITH status = "complete",
         objective = @sharpe_str,
         verify = @verify_status;

END;

-- ── Cross-algorithm comparison workflow ───────────────────────
-- Runs all 6 algorithms on the same data, then uses LLM to
-- synthesise results and recommend the best for this portfolio.
-- This is the SPL synthesis pattern: N deterministic solvers → 1 LLM synthesis.

WORKFLOW portfolio_comparison
  INPUT @tickers TEXT := "AAPL,MSFT,GOOGL,AMZN,NVDA"
  INPUT @capital TEXT := "10000"
  INPUT @period TEXT := "1y"
  INPUT @target_return TEXT := "0.12"
  INPUT @max_weight TEXT := "0.20"
  INPUT @adapter TEXT := "claude_cli"
  INPUT @model TEXT := ""
  INPUT @log_dir TEXT := "./logs"
  INPUT @out_dir TEXT := "cookbook/99_portfolio_opt/outputs"
  OUTPUT @report TEXT
DO
  LOGGING f"[compare] start  tickers={@tickers}  period={@period}" LEVEL INFO

  CALL fetch_stock_data(@tickers, @period) INTO @market_data_json;

  -- Run all 6 algorithms concurrently — inputs are ready, outputs are independent
  CALL PARALLEL
    optimize_by_algorithm(@market_data_json, "markowitz",    @target_return, @max_weight) INTO @r_markowitz,
    optimize_by_algorithm(@market_data_json, "min_variance", @target_return, @max_weight) INTO @r_min_var,
    optimize_by_algorithm(@market_data_json, "max_sharpe",   @target_return, @max_weight) INTO @r_max_sharpe,
    optimize_by_algorithm(@market_data_json, "risk_parity",  @target_return, @max_weight) INTO @r_risk_parity,
    optimize_by_algorithm(@market_data_json, "hrp",          @target_return, @max_weight) INTO @r_hrp,
    optimize_by_algorithm(@market_data_json, "cvar",         @target_return, @max_weight) INTO @r_cvar
  END;

  LOGGING "[compare] all 6 algorithms complete — building CSV and synthesising with LLM" LEVEL INFO

  CALL comparison_to_csv(@tickers,
                         @r_markowitz, @r_min_var, @r_max_sharpe,
                         @r_risk_parity, @r_hrp, @r_cvar) INTO @summary_csv;

  CALL composition_to_csv(@tickers, @capital,
                          @r_markowitz, @r_min_var, @r_max_sharpe,
                          @r_risk_parity, @r_hrp, @r_cvar) INTO @composition_csv;

  CALL PARALLEL
    save_csv(@summary_csv,     @out_dir, "comparison_summary.csv")     INTO @path_summary,
    save_csv(@composition_csv, @out_dir, "comparison_composition.csv") INTO @path_composition
  END;
  LOGGING f"[compare] CSVs saved → {@path_summary}  {@path_composition}" LEVEL INFO

  -- LLM synthesises all results and recommends the best
  GENERATE compare_algorithms(@tickers, @market_data_json,
                               @r_markowitz, @r_min_var, @r_max_sharpe,
                               @r_risk_parity, @r_hrp, @r_cvar)
           INTO @synthesis;

  @report := f"=== Cross-Algorithm Portfolio Comparison ===

Tickers: {@tickers}  |  Period: {@period}  |  Capital: ${@capital}
Target return: {@target_return}  |  Max position: {@max_weight}

Algorithm Summary (CSV):
{@summary_csv}

Portfolio Composition (CSV):
{@composition_csv}

LLM Synthesis & Recommendation:
{@synthesis}";

  RETURN @report WITH status = "complete";

END;
