-- ============================================================
-- Recipe 118: Z3 Trading Rule Checker
--
-- PURPOSE: Encode a trader's entry/exit/risk rulebook as Z3 SMT
-- constraints and verify:
--   SAT  → a valid market scenario exists (strategy can trigger)
--   UNSAT → rules are contradictory (strategy can never fire)
--   SNAPSHOT → given today's indicators, does the strategy signal?
--
-- KEY STORY: A trader's rulebook is a compliance policy over market
-- variables. Z3 audits it for consistency and finds exact boundary
-- conditions — the market state where all rules first align. Manual
-- rule-tracing picks "typical" examples and misses the edges where
-- two rules interact to block or trap the strategy.
--
-- AI ROLE: NL → Z3 translator (LLM extracts the formal spec)
-- SOLVER ROLE: Z3 proves consistency / finds triggering scenario
--
-- This is the IT-era analogy: programmers once hand-coded custom
-- solvers per domain. Now LLM translates; a rigorous solver proves.
-- As the solver collection grows (Z3, LP, Prolog, Nash, CFR...),
-- each becomes a composable building block for larger problems.
--
-- Install: pip install z3-solver
--
-- Run:
--   # Default: Momentum Breakout strategy audit
--   spl3 run cookbook/118_trading_rule_z3/trading_rule_z3.spl \
--       --llm claude_cli
--
--   # Custom trading rules (NL → Z3)
--   spl3 run cookbook/118_trading_rule_z3/trading_rule_z3.spl \
--       --llm claude_cli \
--       --param "rules_text=Enter long when RSI is between 30 and 40, \
--         price is above the 50-day moving average, volume is at least \
--         twice the 20-day average. Never enter if a Fed announcement \
--         is today. Exit if RSI exceeds 70."
--
--   # Market snapshot check (all variables required)
--   spl3 run cookbook/118_trading_rule_z3/trading_rule_z3.spl \
--       --llm claude_cli \
--       --param "snapshot_json={\"rsi\":31,\"price_vs_ma200\":5,\"volume_ratio\":180,\"adr_pct\":25,\"in_uptrend\":true,\"earnings_week\":false}"
-- ============================================================

-- ── Tool APIs ────────────────────────────────────────────────

CREATE TOOL_API get_default_policy()
RETURNS TEXT AS PYTHON $$
def get_default_policy() -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "118_trading_rule_z3")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import get_default_policy as _fn
    return _fn()
$$;

