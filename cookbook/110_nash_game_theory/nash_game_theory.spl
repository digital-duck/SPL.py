-- ============================================================
-- Recipe 110: Nash Equilibrium Game Theory
--
-- PURPOSE: Find Nash equilibria in 2-player normal-form games
-- using nashpy support enumeration. Demonstrates that the
-- rational equilibrium often differs from the cooperative
-- optimum — Prisoner's Dilemma structure in pricing games.
--
-- KEY STORY: Two SaaS firms with High/Low pricing choice.
-- LLM: "Both should hold High prices — mutual benefit."
-- Nash: (Low, Low) is the unique dominant-strategy equilibrium.
-- The $15/mo defection gain makes High price unstable for
-- any individual firm, regardless of the opponent's choice.
--
-- solver=ON  : nashpy support enumeration finds all Nash eq.
-- solver=OFF : LLM reasons about optimal pricing strategy
--
-- Install: pip install nashpy
--
-- Run:
--   spl3 run cookbook/110_nash_game_theory/nash_game_theory.spl \
--       --adapter claude_cli --param use_solver=true
--
--   spl3 run cookbook/110_nash_game_theory/nash_game_theory.spl \
--       --adapter ollama -m gemma3 --param use_solver=false
-- ============================================================

CREATE TOOL_API get_default_game()
RETURNS TEXT AS PYTHON $$
def get_default_game() -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "110_nash_game_theory")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import get_default_game as _fn
    return _fn()
$$;

CREATE TOOL_API find_nash_equilibria(game_json TEXT)
RETURNS TEXT AS PYTHON $$
def find_nash_equilibria(game_json: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "110_nash_game_theory")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import find_nash_equilibria as _fn
    return _fn(game_json)
$$;

CREATE TOOL_API nash_found(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def nash_found(result_json: str) -> bool:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "110_nash_game_theory")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import nash_found as _fn
    return _fn(result_json)
$$;

CREATE TOOL_API format_nash_report(result_json TEXT)
RETURNS TEXT AS PYTHON $$
def format_nash_report(result_json: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "110_nash_game_theory")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import format_nash_report as _fn
    return _fn(result_json)
$$;

CREATE TOOL_API json_get_field(data_json TEXT, field TEXT)
RETURNS TEXT AS PYTHON $$
def json_get_field(data_json: str, field: str) -> str:
    import sys, os
    _dir = os.path.join(os.getcwd(), "cookbook", "110_nash_game_theory")
    if _dir not in sys.path: sys.path.insert(0, _dir)
    from tools import json_get_field as _fn
    return _fn(data_json, field)
$$;

CREATE FUNCTION reason_about_pricing_prompt(game_description TEXT)
RETURNS TEXT AS $$
You are a business strategy consultant advising two SaaS companies in a competitive pricing situation.

SITUATION:
{game_description}

Without computing Nash equilibria, reason through this strategically:
1. What price should Firm A set and why?
2. What price should Firm B set and why?
3. Is there a stable outcome where neither firm regrets their choice?
4. What is the "cooperative" optimum — and why might it not hold?

Give concrete recommendations with reasoning. Do not use game theory formulas — reason from first principles.
$$;

CREATE FUNCTION explain_nash_prompt(nash_report TEXT, game_description TEXT)
RETURNS TEXT AS $$
You are a game theory analyst. nashpy just computed the Nash equilibria for this pricing game.

GAME DESCRIPTION:
{game_description}

NASH EQUILIBRIUM RESULT:
{nash_report}

Explain (≤150 words):
1. What is the Nash equilibrium outcome and what does it mean in business terms?
2. Why does each firm choose Low even though both would be better off at High?
3. What is the Prisoner's Dilemma gap — the collective cost of rational self-interest?
4. What mechanism could break the dilemma in practice (contract, regulation, reputation)?
$$;

WORKFLOW nash_game_theory
  INPUT @use_solver TEXT := "true"
  OUTPUT @report TEXT
DO
  LOGGING "[r110] nash_game_theory start" LEVEL INFO

  CALL get_default_game() INTO @game_json;
  CALL json_get_field(@game_json, "description") INTO @game_description;

  EVALUATE @use_solver
    WHEN "true" THEN
      CALL find_nash_equilibria(@game_json) INTO @result_json;
      ASSERT nash_found(@result_json);
      CALL format_nash_report(@result_json) INTO @nash_report;
      CALL json_get_field(@result_json, "n_equilibria") INTO @n_eq;
      LOGGING f"[r110] found {@n_eq} Nash equilibria" LEVEL INFO;
      GENERATE explain_nash_prompt(@nash_report, @game_description) INTO @explanation;
      @report := f"=== Nash Equilibrium Game Theory (r110) | solver=ON ===

{@nash_report}

── Business Explanation ────────────────────────────────────
{@explanation}"

    WHEN "false" THEN
      GENERATE reason_about_pricing_prompt(@game_description) INTO @llm_strategy;
      @report := f"=== Nash Equilibrium Game Theory (r110) | solver=OFF ===

── LLM Strategic Reasoning ─────────────────────────────────
{@llm_strategy}

Note: LLM reasons from intuition. Run --param use_solver=true to find
Nash equilibria with nashpy (often differs from cooperative intuition)."
  END;

  RETURN @report WITH status = "complete", use_solver = @use_solver;

END;
